<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MeteoApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Météo">

        <!-- The app itself: Slint UI in libmeteo.so, no Java code. -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="meteo" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget (Kotlin Glance, data from libmeteo_widget.so). -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver"
            android:exported="true"
            android:label="Météo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteo_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.RainWidgetReceiver"
            android:exported="true"
            android:label="Météo · Rain">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rain_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.RoundWidgetReceiver"
            android:exported="true"
            android:label="Météo · Round">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/round_widget_info" />
        </receiver>
    </application>
</manifest>
