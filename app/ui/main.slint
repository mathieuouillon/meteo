export struct HourItem {
    label: string,
    temperature: string,
    icon: string,
    precipitation: string,
    x: float,
    y: float,
}

export struct DayItem {
    label: string,
    icon: string,
    precipitation: string,
    min: string,
    max: string,
    bar-start: float,
    bar-end: float,
}

export struct CloudItem {
    x: float,
    y: float,
    scale: float,
    opacity: float,
    dark: bool,
}

export struct FogItem {
    x: float,
    y: float,
    width: float,
    height: float,
    opacity: float,
}

/// One particle layer: a path in window coordinates, drawn 1:1.
component Particles inherits Path {
    in property <string> d;
    // No size set: like most elements outside a layout, it fills its parent.
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fit: fill;
    stroke-line-cap: round;
    commands: root.d == "" ? "M 0 0" : root.d;
}

/// One soft round puff of a cloud: a blurred shadow of its own colour
/// gives it fuzzy edges.
component Puff inherits Rectangle {
    in property <color> tint;
    in property <float> k;
    border-radius: self.height / 2;
    background: @linear-gradient(180deg, root.tint 0%, root.tint.transparentize(30%) 100%);
    drop-shadow-color: root.tint;
    drop-shadow-blur: 14px * root.k;
}

/// A puffy cloud in a 180×80 box, scaled. The group opacity keeps the
/// overlapping puffs from looking darker where they overlap.
component Cloud inherits Rectangle {
    in property <CloudItem> cloud;
    x: root.cloud.x * 1px;
    y: root.cloud.y * 1px;
    width: 180px * root.cloud.scale;
    height: 80px * root.cloud.scale;
    opacity: root.cloud.opacity;
    property <float> k: root.cloud.scale;
    property <color> tint: root.cloud.dark ? #5b6474 : white;
    Puff { tint: root.tint; k: root.k; x: 15px * k; y: 40px * k; width: 150px * k; height: 38px * k; }
    Puff { tint: root.tint; k: root.k; x: 30px * k; y: 15px * k; width: 60px * k; height: self.width; }
    Puff { tint: root.tint; k: root.k; x: 70px * k; y: 0px; width: 78px * k; height: self.width; }
    Puff { tint: root.tint; k: root.k; x: 115px * k; y: 22px * k; width: 50px * k; height: self.width; }
}

/// The animated weather behind the content (driven from Rust, animation.rs).
component Sky inherits Rectangle {
    in property <string> rain-far;
    in property <string> rain-near;
    in property <string> splashes;
    in property <string> snow-small;
    in property <string> snow-large;
    in property <string> stars-dim;
    in property <string> stars-mid;
    in property <string> stars-bright;
    in property <string> bolt;
    in property <float> flash;
    in property <[CloudItem]> clouds;
    in property <[FogItem]> fog;

    Particles { d: root.stars-dim; stroke: #ffffff4d; stroke-width: 2px; }
    Particles { d: root.stars-mid; stroke: #ffffff99; stroke-width: 2.5px; }
    Particles { d: root.stars-bright; stroke: #ffffffee; stroke-width: 3px; }
    for c in root.clouds: Cloud { cloud: c; }
    for f in root.fog: Rectangle {
        x: f.x * 1px; y: f.y * 1px;
        width: f.width * 1px; height: f.height * 1px;
        border-radius: self.height / 2;
        background: white;
        opacity: f.opacity;
    }
    Particles { d: root.rain-far; stroke: #ffffff40; stroke-width: 1px; }
    Particles { d: root.rain-near; stroke: #ffffff8c; stroke-width: 1.6px; }
    Particles { d: root.splashes; stroke: #ffffffaa; stroke-width: 2.5px; }
    Particles { d: root.snow-small; stroke: #ffffffb3; stroke-width: 4px; }
    Particles { d: root.snow-large; stroke: #ffffffee; stroke-width: 7px; }
    // Lightning: a soft glow under a bright core, then the whole sky lights up.
    Particles { d: root.bolt; stroke: #c8d8ff66; stroke-width: 10px; stroke-line-join: round; }
    Particles { d: root.bolt; stroke: white; stroke-width: 2.5px; stroke-line-join: round; }
    if root.flash > 0.01: Rectangle { background: #e8eeff; opacity: root.flash * 0.45; }
}

export struct CityItem {
    name: string,
    detail: string,
    selected: bool,
    /// The device's own position.
    device: bool,
}

/// One city in the picker: name, region/country, and optional actions.
component CityRow inherits Rectangle {
    in property <CityItem> city;
    in property <bool> removable;
    in property <color> accent;
    in property <color> accent-strong;
    callback clicked();
    callback remove();
    height: 60px;
    border-radius: 14px;
    background: touch.pressed ? #ffffff26 : (root.city.selected ? root.accent-strong.with-alpha(0.3) : transparent);
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: (root.city.device ? "📍 " : "") + root.city.name;
                color: white; font-size: 18px; font-weight: root.city.selected ? 600 : 400; overflow: elide;
            }
            if root.city.detail != "": Text { text: root.city.detail; color: #ffffff99; font-size: 13px; overflow: elide; }
        }
        if root.city.selected: Text { text: "✓"; color: root.accent; font-size: 18px; vertical-alignment: center; }
        if root.removable: Rectangle {
            width: 44px;
            // Drawn rather than a "✕" glyph, which Android's font lacks.
            Path {
                width: 12px; height: 12px;
                viewbox-width: 12; viewbox-height: 12;
                fit: fill;
                commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                stroke: remove-touch.pressed ? white : #ffffff80;
                stroke-width: 2px;
            }
            remove-touch := TouchArea { clicked => { root.remove(); } }
        }
    }
}

/// Full-screen list of saved cities with a search box to add new ones.
component CityPicker inherits Rectangle {
    in property <[CityItem]> cities;
    in property <[CityItem]> results;
    in property <string> search-status;
    in property <bool> can-locate;
    in property <color> accent;
    in property <color> accent-strong;
    callback close();
    callback locate();
    callback search(string);
    callback add-city(int);
    callback select-city(int);
    callback remove-city(int);

    background: @linear-gradient(180deg, #141b3a 0%, #0b1026 100%);
    // Swallow taps so they don't reach the screen underneath.
    TouchArea { }

    VerticalLayout {
        padding: 20px;
        padding-top: 48px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 48px;
                border-radius: 14px;
                background: #ffffff1f;
                border-width: 1.5px;
                border-color: input.has-focus ? root.accent : transparent;
                input := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    vertical-alignment: center;
                    color: white;
                    font-size: 17px;
                    single-line: true;
                    selection-background-color: root.accent-strong;
                    edited => { root.search(self.text); }
                }
                if input.text == "": Text {
                    x: 16px;
                    text: "Search for a city";
                    color: #ffffff80;
                    font-size: 17px;
                }
            }
            Rectangle {
                width: 70px;
                Text { text: "Done"; color: root.accent; font-size: 17px; font-weight: 600; }
                TouchArea { clicked => { root.close(); } }
            }
        }

        if root.search-status != "": Text {
            text: root.search-status;
            color: #ffffffb3;
            font-size: 14px;
            wrap: word-wrap;
        }

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 2px;
                if input.text == "" && root.can-locate: Rectangle {
                    height: 52px;
                    border-radius: 14px;
                    background: root.accent-strong.with-alpha(locate-touch.pressed ? 0.6 : 0.4);
                    Text { text: "📍  Use my location"; color: white; font-size: 17px; }
                    locate-touch := TouchArea { clicked => { root.locate(); } }
                }
                if input.text == "" && root.can-locate: Rectangle { height: 10px; }
                if input.text == "": Text {
                    text: "SAVED CITIES"; color: #ffffffb3; font-size: 12px; font-weight: 600;
                }
                if input.text == "": VerticalLayout {
                    spacing: 2px;
                    for c[i] in root.cities: CityRow {
                        city: c;
                        accent: root.accent;
                        accent-strong: root.accent-strong;
                        removable: root.cities.length > 1;
                        clicked => { root.select-city(i); }
                        remove => { root.remove-city(i); }
                    }
                }
                if input.text != "": VerticalLayout {
                    spacing: 2px;
                    for c[i] in root.results: CityRow {
                        city: c;
                        accent: root.accent;
                        accent-strong: root.accent-strong;
                        clicked => { root.add-city(i); }
                    }
                }
            }
        }
    }
}

component DayRow inherits HorizontalLayout {
    in property <DayItem> day;
    spacing: 8px;
    height: 44px;
    Text { text: root.day.label; width: 56px; color: white; font-size: 17px; vertical-alignment: center; }
    Text { text: root.day.icon; width: 30px; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
    Text { text: root.day.precipitation; width: 38px; color: #cfe8ff; font-size: 13px; vertical-alignment: center; }
    Text { text: root.day.min; width: 36px; color: #ffffffb3; font-size: 17px; horizontal-alignment: right; vertical-alignment: center; }
    // Min–max bar, positioned on the whole week's temperature scale.
    Rectangle {
        horizontal-stretch: 1;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 6px;
            border-radius: 3px;
            background: #0000001f;
            Rectangle {
                x: parent.width * root.day.bar-start;
                y: 0;
                width: max(self.height, parent.width * (root.day.bar-end - root.day.bar-start));
                height: parent.height;
                border-radius: 3px;
                background: @linear-gradient(90deg, #6ec1ff 0%, #ffb84d 100%);
            }
        }
    }
    Text { text: root.day.max; width: 36px; color: white; font-size: 17px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
}

component Stat inherits Rectangle {
    in property <string> title;
    in property <string> value;
    background: #ffffff26;
    border-radius: 18px;
    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text { text: root.title; color: #ffffffb3; font-size: 13px; }
        Text { text: root.value; color: white; font-size: 22px; font-weight: 600; }
    }
}

export component MainWindow inherits Window {
    title: "Météo";
    preferred-width: 400px;
    preferred-height: 820px;

    in property <string> city: "—";
    in property <string> temperature: "--°";
    in property <string> condition: "Loading…";
    in property <string> weather-icon;
    in property <string> high-low;
    in property <string> feels-like: "--";
    in property <string> humidity: "--";
    in property <string> wind: "--";
    in property <color> sky-top: #2f80ed;
    in property <color> sky-bottom: #8ec5fc;
    in property <[HourItem]> hours;
    in property <[DayItem]> days;
    in property <string> line-path;
    in property <string> area-path;
    in property <float> chart-width: 1;
    in property <float> chart-height: 150;
    in property <string> error;
    // "Updated 2 h ago" when showing a cached forecast; empty when fresh.
    in property <string> status;
    in property <[CityItem]> cities;
    in property <[CityItem]> results;
    in property <string> search-status;
    in-out property <bool> picker-open;
    // Animated background (see animation.rs).
    in property <string> rain-far;
    in property <string> rain-near;
    in property <string> splashes;
    in property <string> snow-small;
    in property <string> snow-large;
    in property <string> stars-dim;
    in property <string> stars-mid;
    in property <string> stars-bright;
    in property <string> bolt;
    in property <float> flash;
    in property <[CloudItem]> clouds;
    in property <[FogItem]> fog;
    in property <bool> can-locate;
    // System accent (Material You on Android 12+, macOS accent colour); see accent.rs.
    in property <color> accent: #9ecbff;
    in property <color> accent-strong: #2f80ed;
    callback refresh();
    callback locate();
    callback search(string);
    callback add-city(int);
    callback select-city(int);
    callback remove-city(int);

    // Animated copies, so condition changes fade smoothly.
    property <color> top: root.sky-top;
    property <color> bottom: root.sky-bottom;
    animate top, bottom { duration: 800ms; easing: ease-in-out; }

    background: @linear-gradient(180deg, root.top 0%, root.bottom 100%);

    Sky {
        width: root.width;
        height: root.height;
        rain-far: root.rain-far;
        rain-near: root.rain-near;
        splashes: root.splashes;
        snow-small: root.snow-small;
        snow-large: root.snow-large;
        stars-dim: root.stars-dim;
        stars-mid: root.stars-mid;
        stars-bright: root.stars-bright;
        bolt: root.bolt;
        flash: root.flash;
        clouds: root.clouds;
        fog: root.fog;
    }

    // The whole screen scrolls vertically; the sky stays fixed behind it.
    Flickable {
    content-width: self.width;
    content-height: content.preferred-height;
    content := VerticalLayout {
        width: parent.width;
        padding: 24px;
        padding-top: 48px;
        spacing: 18px;

        // ── Header ─────────────────────────────────────────────
        VerticalLayout {
            alignment: start;
            spacing: 2px;
            // Tap the city name to switch or add cities.
            Rectangle {
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text { text: root.city; color: white; font-size: 28px; font-weight: 600; }
                    // Chevron drawn as a path ("▾" is missing from Android's font).
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 14px; height: 8px;
                        viewbox-width: 14; viewbox-height: 8;
                        fit: fill;
                        commands: "M 1 1 L 7 7 L 13 1";
                        stroke: root.accent;
                        stroke-width: 2.5px;
                    }
                }
                }
                TouchArea { clicked => { root.picker-open = true; } }
            }
            Text { text: root.weather-icon; font-size: 64px; horizontal-alignment: center; }
            Text { text: root.temperature; color: white; font-size: 96px; font-weight: 200; horizontal-alignment: center; }
            Text { text: root.condition; color: white; font-size: 22px; horizontal-alignment: center; }
            Text { text: root.high-low; color: #ffffffcc; font-size: 16px; horizontal-alignment: center; }
            if root.status != "": Text {
                text: root.status; color: #ffffffb3; font-size: 13px; horizontal-alignment: center;
            }
            if root.error != "": Text {
                text: root.error; color: #ffd0d0; font-size: 13px;
                horizontal-alignment: center; wrap: word-wrap;
            }
        }

        // ── Hourly curve ───────────────────────────────────────
        Rectangle {
            background: #ffffff26;
            border-radius: 22px;
            height: 270px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: "NEXT 24 HOURS"; color: #ffffffb3; font-size: 12px; font-weight: 600; }
                Flickable {
                    content-width: root.chart-width * 1px;
                    content-height: self.height;
                    // Area under the curve
                    Path {
                        x: 0; y: 0;
                        width: root.chart-width * 1px;
                        height: root.chart-height * 1px;
                        viewbox-width: root.chart-width;
                        viewbox-height: root.chart-height;
                        // Map viewbox 1:1 (default `contain` rescales and centres when stroked).
                        fit: fill;
                        commands: root.area-path;
                        fill: @linear-gradient(180deg, #ffffff59 0%, #ffffff00 100%);
                        stroke-width: 0px;
                    }
                    // The curve itself
                    Path {
                        x: 0; y: 0;
                        width: root.chart-width * 1px;
                        height: root.chart-height * 1px;
                        viewbox-width: root.chart-width;
                        viewbox-height: root.chart-height;
                        // Map viewbox 1:1 (default `contain` rescales and centres when stroked).
                        fit: fill;
                        commands: root.line-path;
                        stroke: white;
                        stroke-width: 3px;
                    }
                    for h in root.hours: Rectangle {
                        x: h.x * 1px - 30px;
                        y: 0;
                        width: 60px;
                        height: parent.height;
                        Text {
                            y: h.y * 1px - 28px;
                            width: parent.width;
                            text: h.temperature;
                            color: white; font-size: 15px; font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            x: 25px; y: h.y * 1px - 5px;
                            width: 10px; height: 10px; border-radius: 5px;
                            background: white;
                        }
                        Text {
                            y: root.chart-height * 1px + 4px;
                            width: parent.width;
                            text: h.icon; font-size: 22px;
                            horizontal-alignment: center;
                        }
                        Text {
                            y: root.chart-height * 1px + 34px;
                            width: parent.width;
                            text: h.precipitation; color: #cfe8ff; font-size: 12px;
                            horizontal-alignment: center;
                        }
                        Text {
                            y: root.chart-height * 1px + 52px;
                            width: parent.width;
                            text: h.label; color: #ffffffcc; font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // ── 7-day forecast ─────────────────────────────────────
        Rectangle {
            background: #ffffff26;
            border-radius: 22px;
            VerticalLayout {
                padding: 16px;
                padding-bottom: 8px;
                spacing: 0px;
                Text { text: "7-DAY FORECAST"; color: #ffffffb3; font-size: 12px; font-weight: 600; }
                for d in root.days: DayRow { day: d; }
            }
        }

        // ── Details ────────────────────────────────────────────
        HorizontalLayout {
            spacing: 12px;
            Stat { title: "FEELS LIKE"; value: root.feels-like; }
            Stat { title: "HUMIDITY"; value: root.humidity; }
            Stat { title: "WIND"; value: root.wind; }
        }

        Rectangle {
            height: 44px;
            border-radius: 22px;
            background: root.accent-strong.with-alpha(touch.pressed ? 0.7 : 0.45);
            Text { text: "Refresh"; color: white; font-size: 16px; font-weight: 600; }
            touch := TouchArea { clicked => { root.refresh(); } }
        }

    }
    }

    if root.picker-open: CityPicker {
        width: root.width;
        height: root.height;
        cities: root.cities;
        results: root.results;
        search-status: root.search-status;
        can-locate: root.can-locate;
        accent: root.accent;
        accent-strong: root.accent-strong;
        locate => { root.locate(); }
        close => { root.picker-open = false; root.search(""); }
        search(text) => { root.search(text); }
        add-city(i) => { root.add-city(i); self.close(); }
        select-city(i) => { root.select-city(i); self.close(); }
        remove-city(i) => { root.remove-city(i); }
    }
}
