// Météo — an editorial page: paper and ink whose tones follow the weather,
// serif numbers and headlines, sections ruled like a newspaper column, and
// a quiet landscape drawn tone on tone.

import { WeatherIcon } from "icons.slint";
// Lexend for the small text and Newsreader, a newspaper serif, for the
// numbers and headlines (both SIL Open Font License, fonts/), embedded in
// the app.
import "fonts/Lexend.ttf";
import "fonts/Newsreader.ttf";
import "fonts/Newsreader-Italic.ttf";
//
// All values (texts, colours, chart and landscape geometry) come ready-made
// from Rust (meteo-core); this file only lays them out.

/// Material 3 colour roles (see app/src/theme.rs).
export struct Theme {
    primary: color,
    on-primary: color,
    primary-container: color,
    on-primary-container: color,
    secondary-container: color,
    on-secondary-container: color,
    tertiary-container: color,
    on-tertiary-container: color,
    surface: color,
    surface-container: color,
    surface-container-high: color,
    on-surface: color,
    on-surface-variant: color,
    outline-variant: color,
    /// Background gradient, rain/snow streaks and clouds.
    bg-top: color,
    bg-bottom: color,
    particle: color,
    cloud: color,
}

/// Fixed texts, in the user's language (core/src/i18n.rs).
export struct Labels {
    forecast: string,
    feels-like: string,
    humidity: string,
    wind: string,
    sun: string,
    uv-index: string,
    pressure: string,
    details: string,
    refresh: string,
    data-credit: string,
    data-source: string,
    data-source-help: string,
    search: string,
    done: string,
    use-location: string,
    saved-cities: string,
    next-hours: string,
    radar: string,
    radar-link: string,
    radar-credit: string,
    radar-region: string,
    radar-wide: string,
    rain-light: string,
    rain-moderate: string,
    rain-heavy: string,
    rain-violent: string,
    now: string,
    air-quality: string,
    pollen: string,
    settings: string,
    units: string,
    metric: string,
    imperial: string,
    colors: string,
    colors-weather: string,
    colors-wallpaper: string,
    language: string,
    language-system: string,
    notifications: string,
    morning-summary: string,
    morning-summary-help: string,
    rain-alerts: string,
    rain-alerts-help: string,
    warning-alerts: string,
    warning-alerts-help: string,
    temperature-alerts: string,
    temperature-alerts-help: string,
    widgets: string,
    notifications-blocked: string,
    notifications-allow: string,
    notifications-test: string,
    widget-solid: string,
    widget-see-through: string,
    warnings-source: string,
}

/// The details tiles (DetailsView in core/src/view.rs).
export struct Details {
    feels-like: string,
    feels-note: string,
    humidity: string,
    dew-point: string,
    wind-speed: string,
    wind-unit: string,
    wind-gusts: string,
    wind-from: string,
    wind-arrow-path: string,
    sunrise: string,
    sunset: string,
    daylight: string,
    uv: string,
    uv-level: string,
    pressure: string,
    pressure-note: string,
}

/// One hour of a day's chart (see DayHourView in core/src/view.rs).
export struct DayHour {
    label: string,
    temperature: string,
    icon: string,
    icon-kind: string,
    precipitation: string,
    /// The chance of rain, 0–1, and what a tap on the hour shows.
    chance: float,
    tip: string,
    tip-range: string,
    rain: string,
    rain-height: float,
    // The models' range of rain ("0.4–2.1") and its heights; empty when they agree.
    rain-range: string,
    range-low: float,
    range-high: float,
    is-now: bool,
    x: float,
    y: float,
}

export struct DayItem {
    label: string,
    icon: string,
    icon-kind: string,
    precipitation: string,
    min: string,
    max: string,
    bar-start: float,
    bar-end: float,
    rain-total: string,
    first-hour: int,
    hours: [DayHour],
    rain-peak: float,
    has-chance: bool,
    chart-width: float,
    chart-height: float,
    line-path: string,
    area-path: string,
    /// Several models' range around the curve, and how much they agree.
    band-path: string,
    agreement: string,
    has-range: bool,
}

export struct CloudItem {
    x: float,
    y: float,
    scale: float,
    opacity: float,
    dark: bool,
}

export struct FogItem {
    x: float,
    y: float,
    width: float,
    height: float,
    opacity: float,
}

/// Rain over the next 2 hours (NowcastView in core/src/view.rs).
export struct NowBar {
    label: string,
    height: float,
    wet: bool,
}

/// An official weather warning (WarningView in core/src/view.rs).
export struct WarningItem {
    title: string,
    detail: string,
    /// 1 yellow, 2 orange, 3 red.
    level: int,
}

export struct Nowcast {
    summary: string,
    wet: bool,
    bars: [NowBar],
}

/// Air quality and pollen (AirView in core/src/view.rs).
export struct AirInfo {
    aqi: string,
    aqi-level: string,
    pollen: string,
    pollen-level: string,
    /// "Sat moderate · Sun high · Mon low"; empty when nothing's coming.
    pollen-outlook: string,
}

/// One silhouette of the landscape (core/src/landscape.rs), far to near.
export struct LandLayer {
    path: string,
    color: color,
}

export struct CityItem {
    name: string,
    detail: string,
    selected: bool,
    /// The device's own position.
    device: bool,
}

// ── The scene ───────────────────────────────────────────────────────────

/// One particle layer: a path in window coordinates, drawn 1:1.
component Particles inherits Path {
    in property <string> d;
    // No size set: like most elements outside a layout, it fills its parent.
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fit: fill;
    stroke-line-cap: round;
    commands: root.d == "" ? "M 0 0" : root.d;
}

/// One soft round puff of a cloud: a blurred shadow of its own colour
/// gives it fuzzy edges.
component Puff inherits Rectangle {
    in property <color> tint;
    in property <float> k;
    border-radius: self.height / 2;
    background: @linear-gradient(180deg, root.tint 0%, root.tint.transparentize(30%) 100%);
    drop-shadow-color: root.tint;
    drop-shadow-blur: 14px * root.k;
}

/// A puffy cloud in a 180×80 box, scaled. The group opacity keeps the
/// overlapping puffs from looking darker where they overlap.
component Cloud inherits Rectangle {
    in property <CloudItem> cloud;
    in property <color> tint: white;
    x: root.cloud.x * 1px;
    y: root.cloud.y * 1px;
    width: 180px * root.cloud.scale;
    height: 80px * root.cloud.scale;
    opacity: root.cloud.opacity;
    property <float> k: root.cloud.scale;
    Puff { tint: root.tint; k: root.k; x: 15px * k; y: 40px * k; width: 150px * k; height: 38px * k; }
    Puff { tint: root.tint; k: root.k; x: 30px * k; y: 15px * k; width: 60px * k; height: self.width; }
    Puff { tint: root.tint; k: root.k; x: 70px * k; y: 0px; width: 78px * k; height: self.width; }
    Puff { tint: root.tint; k: root.k; x: 115px * k; y: 22px * k; width: 50px * k; height: self.width; }
}

/// Mountains, hills and pines (400×300 box, scaled to this band), tone on
/// tone. As the page scrolls the far layers lag behind (parallax).
component Landscape inherits Rectangle {
    in property <[LandLayer]> layers;
    /// How far the page is scrolled.
    in property <length> scroll;
    for layer[i] in root.layers: Path {
        x: 0;
        y: root.scroll * (0.32 - 0.08 * i);
        width: root.width;
        height: root.height;
        viewbox-width: 400;
        viewbox-height: 300;
        fit: fill;
        commands: layer.path == "" ? "M 0 0" : layer.path;
        fill: layer.color;
        // The layers are updated in place, so their colours fade.
        animate fill { duration: 800ms; easing: ease-in-out; }
        stroke-width: 0px;
    }
}

/// The serif, for numbers and headlines.
global Type {
    out property <string> serif: "Newsreader";
}

/// A section's name in small spaced capitals over a rule, with an optional
/// link on the right ("RADAR ›").
component SectionHead inherits VerticalLayout {
    in property <string> text;
    in property <string> link;
    in property <Theme> theme;
    callback clicked();
    spacing: 7px;
    HorizontalLayout {
        Text {
            text: root.text.to-uppercase();
            color: root.theme.on-surface-variant;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 1.6px;
            vertical-alignment: bottom;
        }
        if root.link != "": Rectangle {
            width: link-text.preferred-width;
            link-text := Text {
                x: 0;
                text: root.link.to-uppercase();
                color: link-touch.pressed ? root.theme.on-surface : root.theme.primary;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1.6px;
                vertical-alignment: bottom;
            }
            link-touch := TouchArea { y: -14px; height: parent.height + 22px; x: -12px; width: parent.width + 24px; clicked => { root.clicked(); } }
        }
    }
    Rectangle { height: 1px; background: root.theme.on-surface; }
}

/// One detail: what it is, the value in the serif, and a note.
component DetailCell inherits Rectangle {
    in property <Theme> theme;
    in property <string> label;
    in property <string> value;
    in property <string> note;
    /// For the wind: a small compass beside the value. The arrow points where
    /// the wind goes; the dial turns against the phone's heading.
    in property <string> arrow;
    in property <float> heading;
    // Two equal columns, whatever the values.
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 1px;
        Text { text: root.label; color: root.theme.on-surface-variant; font-size: 11.5px; overflow: elide; }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.value;
                color: root.theme.on-surface;
                font-family: Type.serif;
                font-size: 23px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.arrow != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px; height: 24px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.theme.outline-variant;
                    Rectangle {
                        width: 24px; height: 24px;
                        transform-rotation: -root.heading * 1deg;
                        Path {
                            width: 24px; height: 24px;
                            viewbox-width: 64; viewbox-height: 64;
                            fit: fill;
                            commands: root.arrow;
                            fill: root.theme.primary;
                            stroke-width: 0px;
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.note != "": Text { text: root.note; color: root.theme.on-surface-variant; font-size: 11.5px; wrap: word-wrap; }
    }
}

// ── The week ────────────────────────────────────────────────────────────

component DayRow inherits Rectangle {
    in property <DayItem> day;
    in property <bool> open;
    in property <bool> last;
    in property <Theme> theme;
    callback clicked();
    // Drawn once into an image and reused (text is the costliest part of a frame).
    cache-rendering-hint: true;
    height: 50px;
    background: touch.pressed ? root.theme.surface-container-high : transparent;
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.day.label; width: 92px;
            color: root.theme.on-surface;
            font-family: Type.serif;
            font-size: 19px;
            font-italic: root.open;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            width: 26px;
            alignment: center;
            WeatherIcon {
                width: 26px; height: 26px;
                kind: root.day.icon-kind;
                ink: root.theme.on-surface-variant;
                cloud-fill: root.theme.surface;
            }
        }
        // Rain: the day's total (or the chance), in the accent.
        Text {
            width: 56px;
            text: root.day.rain-total != "" ? root.day.rain-total : root.day.precipitation;
            color: root.theme.primary;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.day.min; width: 30px;
            color: root.theme.on-surface-variant; font-size: 15px;
            horizontal-alignment: right; vertical-alignment: center;
        }
        // Min–max on the whole week's scale: a hairline with an ink stroke.
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 1px;
                background: root.theme.outline-variant;
            }
            Rectangle {
                x: parent.width * root.day.bar-start;
                y: (parent.height - self.height) / 2;
                width: max(self.height, parent.width * (root.day.bar-end - root.day.bar-start));
                height: 3px;
                border-radius: 1.5px;
                background: root.theme.on-surface;
            }
        }
        Text {
            text: root.day.max; width: 38px;
            color: root.theme.on-surface;
            font-family: Type.serif;
            font-size: 19px;
            horizontal-alignment: right; vertical-alignment: center;
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: root.theme.outline-variant;
    }
}

/// A day hour by hour, shown when its row is opened: the temperature curve,
/// the weather, the chance of rain and the expected amount, scrolling
/// sideways. Rain bars share the week's scale.
component DayChart inherits Rectangle {
    in property <DayItem> day;
    in property <Theme> theme;
    /// True while a finger is moving the hours sideways. The page's vertical
    /// scrolling pauses meanwhile: otherwise it takes the swipe over as soon
    /// as the finger drifts 8px up or down, which a thumb almost always does.
    out property <bool> panning;
    property <duration> last-flick;
    // Swipe over: no movement for a moment.
    Timer {
        interval: 150ms;
        running: root.panning;
        triggered => {
            if (animation-tick() - root.last-flick > 250ms) {
                root.panning = false;
            }
        }
    }
    property <length> step: 56px;
    property <length> curve: root.day.chart-height * 1px;
    // Rows below the curve, only as tall as this day needs: the chance row
    // only if some hour has one, the bars only as tall as the wettest hour.
    property <length> bar-max: 40px;
    property <length> icon-y: root.curve + 6px;
    property <length> rain-top: root.curve + 38px;
    // Room for the amount label above the tallest bar (none on a dry day).
    property <length> rain-room: root.day.rain-peak > 0 ? max(4px, root.day.rain-peak * root.bar-max) + 16px : 3px;
    /// The tapped hour (-1: none): its chance and the runs' range show above it.
    in-out property <int> picked: -1;
    property <length> rain-base: root.rain-top + root.rain-room;
    // Room for "Models agree 82%" above the chart.
    property <length> head: root.day.agreement != "" ? head-text.preferred-height + 8px : 0px;
    height: root.head + root.rain-base + 32px;

    head-text := Text {
        visible: root.day.agreement != "";
        x: 0px; y: 4px;
        text: root.day.agreement;
        color: root.theme.on-surface-variant; font-size: 12px;
        font-family: Type.serif; font-italic: true;
    }

    Flickable {
        y: root.head;
        height: parent.height - root.head;
        content-width: root.day.chart-width * 1px;
        content-height: self.height;
        flicked => {
            root.last-flick = animation-tick();
            root.panning = true;
        }
        // Open with the hour before `first-hour` at the left edge.
        content-x: -max(0, min(root.day.first-hour - 1, root.day.hours.length - floor(self.width / root.step))) * root.step;

        // The models' range, then the area under the curve, then the curve,
        // cached as one image: swiping only slides it (Skia would otherwise
        // redraw these long curves on the CPU every frame).
        Rectangle {
            x: 0; y: 0;
            width: root.day.chart-width * 1px;
            height: root.curve;
            cache-rendering-hint: true;
            if root.day.band-path != "": Path {
                x: 0; y: 0;
                width: root.day.chart-width * 1px;
                height: root.curve;
                viewbox-width: root.day.chart-width;
                viewbox-height: root.day.chart-height;
                fit: fill;
                commands: root.day.band-path;
                fill: root.theme.on-surface.transparentize(90%);
                stroke-width: 0px;
            }
            Path {
                x: 0; y: 0;
                width: root.day.chart-width * 1px;
                height: root.curve;
                viewbox-width: root.day.chart-width;
                viewbox-height: root.day.chart-height;
                // Map the viewbox 1:1 (the default `contain` rescales a stroked path).
                fit: fill;
                commands: root.day.area-path == "" ? "M 0 0" : root.day.area-path;
                fill: transparent;
                stroke-width: 0px;
            }
            Path {
                x: 0; y: 0;
                width: root.day.chart-width * 1px;
                height: root.curve;
                viewbox-width: root.day.chart-width;
                viewbox-height: root.day.chart-height;
                fit: fill;
                commands: root.day.line-path == "" ? "M 0 0" : root.day.line-path;
                stroke: root.theme.on-surface;
                stroke-width: 1.5px;
            }
        }

        for h[hour-index] in root.day.hours: column := Rectangle {
            x: h.x * 1px - root.step / 2;
            y: 0;
            width: root.step;
            height: parent.height;
            // Each hour drawn once and reused while the hours slide.
            cache-rendering-hint: true;
            property <length> bar: h.rain == "" ? 3px : max(4px, h.rain-height * root.bar-max);
            // Top of what's drawn for this hour: the bar or the models' range.
            property <length> top: h.rain-range == "" ? self.bar : max(self.bar, h.range-high * root.bar-max);
            property <bool> now: h.is-now;
            Text {
                y: h.y * 1px - 24px;
                width: parent.width;
                text: h.temperature;
                color: root.theme.on-surface; font-size: 16px;
                font-family: Type.serif;
                horizontal-alignment: center;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: h.y * 1px - self.height / 2;
                width: column.now ? 11px : 5px; height: self.width; border-radius: self.width / 2;
                background: column.now ? root.theme.surface : root.theme.on-surface;
                border-width: column.now ? 1.5px : 0px;
                border-color: root.theme.on-surface;
            }
            WeatherIcon {
                x: (column.width - self.width) / 2;
                y: root.icon-y;
                width: 24px; height: 24px;
                kind: h.icon-kind;
                ink: root.theme.on-surface-variant;
                cloud-fill: root.theme.surface;
            }
            // Rain: the amount above a bar growing up from the baseline, the
            // bar as strong as the chance; the runs' range a faint wider bar
            // behind it.
            if h.rain-range != "": Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.rain-base - h.range-high * root.bar-max;
                width: 16px;
                height: max(4px, (h.range-high - h.range-low) * root.bar-max);
                border-radius: 2px;
                background: root.theme.primary.transparentize(84%);
            }
            Text {
                y: root.rain-base - parent.top - 16px;
                width: parent.width;
                text: h.rain; color: root.theme.primary; font-size: 11px; font-weight: 500;
                horizontal-alignment: center;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.rain-base - parent.bar;
                width: h.rain == "" ? 14px : 6px;
                height: h.rain == "" ? 1px : parent.bar;
                border-radius: 1px;
                background: h.rain == "" ? root.theme.outline-variant : root.theme.primary;
                opacity: h.rain == "" ? 1 : 0.3 + 0.7 * h.chance;
            }
            // The hour; "Now" in ink, underlined in the accent.
            Rectangle {
                y: root.rain-base + 6px;
                height: 22px;
                now-label := Text {
                    text: h.label;
                    color: column.now ? root.theme.on-surface : root.theme.on-surface-variant;
                    font-size: 12px;
                    font-weight: column.now ? 600 : 400;
                }
                if column.now: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 1px;
                    width: now-label.preferred-width;
                    height: 2px;
                    background: root.theme.primary;
                }
            }
            TouchArea {
                clicked => { root.picked = root.picked == hour-index || h.tip == "" ? -1 : hour-index; }
            }
        }

        // The tapped hour's details, over its neighbours.
        if root.picked >= 0 && root.picked < root.day.hours.length: tip := Rectangle {
            property <DayHour> h: root.day.hours[root.picked];
            property <length> top: self.h.rain-range == "" ? max(3px, self.h.rain-height * root.bar-max) : max(self.h.rain-height, self.h.range-high) * root.bar-max;
            x: max(4px, min(root.day.chart-width * 1px - self.width - 4px, self.h.x * 1px - self.width / 2));
            y: max(root.rain-top - 12px, root.rain-base - self.top - 18px - self.height);
            width: tip-layout.preferred-width;
            height: tip-layout.preferred-height;
            border-radius: 3px;
            background: root.theme.surface;
            border-width: 1px;
            border-color: root.theme.on-surface;
            tip-layout := VerticalLayout {
                padding: 6px;
                padding-left: 10px;
                padding-right: 10px;
                Text { text: tip.h.tip; color: root.theme.on-surface; font-family: Type.serif; font-size: 14px; horizontal-alignment: center; }
                if tip.h.tip-range != "": Text { text: tip.h.tip-range; color: root.theme.on-surface-variant; font-size: 11px; horizontal-alignment: center; }
            }
        }
    }
}

/// Rain over the next 2 hours: a summary, and 15-minute bars when wet.
/// The official warnings: one coloured line each (yellow, orange, red), a
/// warning sign, and the source. Tapping opens MeteoAlarm.
component WarningsCard inherits Rectangle {
    in property <[WarningItem]> warnings;
    in property <string> source;
    callback open();
    border-radius: 4px;
    // The strongest level sets the card's colour.
    property <int> top: root.warnings.length > 0 ? root.warnings[0].level : 1;
    background: root.top >= 3 ? #d93a2b : root.top == 2 ? #f08a24 : #f6c945;
    property <color> ink: root.top >= 3 ? #ffffff : root.top == 2 ? #2b1400 : #2e2400;
    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        for w in root.warnings: HorizontalLayout {
            spacing: 12px;
            // A warning sign, in the line's own level colour when it differs.
            Rectangle {
                width: 26px;
                Path {
                    width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    fit: fill;
                    commands: "M 12 3 L 22 20 L 2 20 Z M 12 9 L 12 14 M 12 17 L 12 17.2";
                    stroke: w.level == root.top ? root.ink
                        : w.level == 2 ? #b85a00 : #8a6d00;
                    stroke-width: 2px;
                    stroke-line-join: round;
                    stroke-line-cap: round;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: w.title; color: root.ink; font-family: Type.serif; font-size: 18px; wrap: word-wrap; }
                Text { text: w.detail; color: root.ink.transparentize(20%); font-size: 12px; }
            }
        }
        Text { text: root.source; color: root.ink.transparentize(35%); font-size: 11px; horizontal-alignment: right; }
    }
    TouchArea { clicked => { root.open(); } }
}

component NowcastCard inherits VerticalLayout {
    in property <Nowcast> nowcast;
    in property <string> title;
    in property <string> link;
    in property <Theme> theme;
    callback clicked();
    spacing: 8px;
    SectionHead {
        theme: root.theme;
        text: root.title;
        link: root.link;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.nowcast.summary;
        color: root.theme.on-surface;
        font-family: Type.serif;
        font-size: 21px;
        wrap: word-wrap;
    }
    // 15 minutes a stem, on a baseline.
    if root.nowcast.wet: Rectangle {
        height: 54px;
        Rectangle { y: 34px; height: 1px; background: root.theme.on-surface; }
        HorizontalLayout {
            spacing: 6px;
            for bar in root.nowcast.bars: Rectangle {
                Rectangle {
                    x: 0;
                    y: 34px - self.height;
                    width: 4px;
                    height: bar.wet ? max(3px, bar.height * 30px) : 0px;
                    border-radius: 1px;
                    background: root.theme.primary;
                }
                Text {
                    // From the stem: "Now" starts with the first.
                    x: 0;
                    y: 40px;
                    width: parent.width * 2;
                    text: bar.label;
                    color: root.theme.on-surface-variant; font-size: 11px;
                }
            }
        }
    }
}

/// A row of choices, one selected: framed in ink, the chosen one inverted.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <Theme> theme;
    callback chosen(int);
    height: 40px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.theme.on-surface;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            border-radius: 2px;
            background: i == root.selected ? root.theme.on-surface : (option-touch.pressed ? root.theme.surface-container-high : transparent);
            Text {
                text: option;
                color: i == root.selected ? root.theme.surface : root.theme.on-surface;
                font-size: 13px; font-weight: i == root.selected ? 600 : 400;
                horizontal-alignment: center;
                overflow: elide;
            }
            // Reaches past the frame so the target is 48px tall.
            option-touch := TouchArea { y: -5px; height: parent.height + 10px; clicked => { root.chosen(i); } }
        }
    }
}

/// A labelled on/off switch.
component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in property <bool> on;
    in property <Theme> theme;
    callback toggled(bool);
    min-height: 60px;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Text { text: root.title; color: root.theme.on-surface; font-family: Type.serif; font-size: 18px; }
            Text { text: root.help; color: root.theme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
        }
        // The switch: a track with a sliding thumb.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px; height: 26px;
                border-radius: 13px;
                background: root.on ? root.theme.on-surface : transparent;
                border-width: 1.5px;
                border-color: root.theme.on-surface;
                Rectangle {
                    x: root.on ? parent.width - self.width - 4px : 4px;
                    animate x { duration: 150ms; easing: ease-out; }
                    width: 18px; height: self.width; border-radius: self.width / 2;
                    background: root.on ? root.theme.surface : root.theme.on-surface;
                }
            }
        }
    }
    TouchArea { clicked => { root.toggled(!root.on); } }
}

/// A group of settings: under a rule, no card.
component SettingsCard inherits Rectangle {
    in property <Theme> theme;
    Rectangle { y: 0; height: 1px; background: root.theme.on-surface; }
}

/// A setting's name in small spaced capitals, over its choices.
component SettingLabel inherits Text {
    in property <Theme> theme;
    in property <string> label;
    text: root.label.to-uppercase();
    color: root.theme.on-surface-variant;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.6px;
}

/// The settings screen.
component SettingsScreen inherits Rectangle {
    in property <Theme> theme;
    in property <Labels> labels;
    in property <int> units-index;
    in property <int> colors-index;
    in property <int> widget-transparency-index;
    in property <int> widget-colors-index;
    in property <int> language-index;
    in property <bool> morning-summary;
    in property <bool> rain-alerts;
    in property <bool> warning-alerts;
    in property <bool> temperature-alerts;
    in property <bool> notifications-blocked;
    in property <bool> can-use-wallpaper;
    in property <string> source-name;
    callback close();
    callback open-sources();
    callback set-units(int);
    callback set-colors(int);
    callback set-widget-transparency(int);
    callback set-widget-colors(int);
    callback set-language(int);
    callback set-morning-summary(bool);
    callback set-rain-alerts(bool);
    callback set-warning-alerts(bool);
    callback set-temperature-alerts(bool);
    callback open-notification-settings();
    callback test-notifications();
    background: root.theme.surface;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        padding-top: 44px;
        spacing: 8px;
        HorizontalLayout {
            padding-left: 8px;
            Text { text: root.labels.settings; color: root.theme.on-surface; font-family: Type.serif; font-size: 34px; vertical-alignment: center; }
            Rectangle {
                width: 72px; height: 48px;
                Text { text: root.labels.done.to-uppercase(); color: root.theme.primary; font-size: 12px; font-weight: 600; letter-spacing: 1.6px; }
                TouchArea { clicked => { root.close(); } }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: settings-list.preferred-height;
            settings-list := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 22px;
                padding: 8px;
                padding-bottom: 32px;
                // Display: units, colours, widgets, language.
                SettingsCard {
                    theme: root.theme;
                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        SettingLabel { theme: root.theme; label: root.labels.units; }
                        Segmented {
                            theme: root.theme;
                            options: [root.labels.metric, root.labels.imperial];
                            selected: root.units-index;
                            chosen(i) => { root.set-units(i); }
                        }
                        if root.can-use-wallpaper: SettingLabel { theme: root.theme; label: root.labels.colors; }
                        if root.can-use-wallpaper: Segmented {
                            theme: root.theme;
                            options: [root.labels.colors-weather, root.labels.colors-wallpaper];
                            selected: root.colors-index;
                            chosen(i) => { root.set-colors(i); }
                        }
                        SettingLabel { theme: root.theme; label: root.labels.widgets; }
                        Segmented {
                            theme: root.theme;
                            options: [root.labels.widget-solid, root.labels.widget-see-through + " 20%", root.labels.widget-see-through + " 40%"];
                            selected: root.widget-transparency-index;
                            chosen(i) => { root.set-widget-transparency(i); }
                        }
                        if root.can-use-wallpaper: Segmented {
                            theme: root.theme;
                            options: [root.labels.colors-weather, root.labels.colors-wallpaper];
                            selected: root.widget-colors-index;
                            chosen(i) => { root.set-widget-colors(i); }
                        }
                        SettingLabel { theme: root.theme; label: root.labels.language; }
                        Segmented {
                            theme: root.theme;
                            options: [root.labels.language-system, "English", "Français"];
                            selected: root.language-index;
                            chosen(i) => { root.set-language(i); }
                        }
                    }
                }
                // Notifications: the switches, one card.
                SettingsCard {
                    theme: root.theme;
                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 0px;
                        spacing: 0px;
                        SettingLabel { theme: root.theme; label: root.labels.notifications; }
                        if root.notifications-blocked: Rectangle {
                            border-radius: 4px;
                            background: blocked-touch.pressed ? root.theme.primary-container.darker(8%) : root.theme.primary-container;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                Text {
                                    text: root.labels.notifications-blocked;
                                    color: root.theme.on-primary-container;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.labels.notifications-allow;
                                    color: root.theme.on-primary-container;
                                    font-size: 15px;
                                    font-weight: 600;
                                }
                            }
                            blocked-touch := TouchArea { clicked => { root.open-notification-settings(); } }
                        }
                        SwitchRow {
                            theme: root.theme;
                            title: root.labels.morning-summary; help: root.labels.morning-summary-help;
                            on: root.morning-summary;
                            toggled(on) => { root.set-morning-summary(on); }
                        }
                        Rectangle { height: 1px; background: root.theme.outline-variant.transparentize(40%); }
                        SwitchRow {
                            theme: root.theme;
                            title: root.labels.rain-alerts; help: root.labels.rain-alerts-help;
                            on: root.rain-alerts;
                            toggled(on) => { root.set-rain-alerts(on); }
                        }
                        Rectangle { height: 1px; background: root.theme.outline-variant.transparentize(40%); }
                        SwitchRow {
                            theme: root.theme;
                            title: root.labels.warning-alerts; help: root.labels.warning-alerts-help;
                            on: root.warning-alerts;
                            toggled(on) => { root.set-warning-alerts(on); }
                        }
                        Rectangle { height: 1px; background: root.theme.outline-variant.transparentize(40%); }
                        SwitchRow {
                            theme: root.theme;
                            title: root.labels.temperature-alerts; help: root.labels.temperature-alerts-help;
                            on: root.temperature-alerts;
                            toggled(on) => { root.set-temperature-alerts(on); }
                        }
                        // A quiet link: try every kind of notification.
                        Rectangle {
                            height: 44px;
                            Text {
                                x: 0;
                                text: root.labels.notifications-test;
                                color: test-touch.pressed ? root.theme.on-surface : root.theme.primary;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            test-touch := TouchArea { clicked => { root.test-notifications(); } }
                        }
                    }
                }
                // Where the forecast comes from.
                SettingsCard {
                    theme: root.theme;
                    height: 64px;
                    background: src-touch.pressed ? root.theme.surface-container-high : transparent;
                    HorizontalLayout {
                        padding-left: 0px; padding-right: 4px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: root.labels.data-source; color: root.theme.on-surface-variant; font-size: 12px; }
                            Text { text: root.source-name + " · Open-Meteo"; color: root.theme.on-surface; font-family: Type.serif; font-size: 19px; }
                        }
                        Text { text: "›"; color: root.theme.primary; font-size: 22px; vertical-alignment: center; horizontal-alignment: right; }
                    }
                    src-touch := TouchArea { clicked => { root.open-sources(); } }
                }
            }
        }
    }
}

// ── Pickers ─────────────────────────────────────────────────────────────

/// One city (or data source) in a picker list.
component CityRow inherits Rectangle {
    in property <CityItem> city;
    in property <bool> removable;
    in property <Theme> theme;
    callback clicked();
    callback remove();
    min-height: 64px;
    border-radius: 4px;
    background: root.city.selected ? root.theme.secondary-container
        : (touch.pressed ? root.theme.surface-container-high : transparent);
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: (root.city.device ? "📍 " : "") + root.city.name;
                color: root.city.selected ? root.theme.on-secondary-container : root.theme.on-surface;
                font-size: 17px; font-weight: root.city.selected ? 600 : 400; overflow: elide;
            }
            if root.city.detail != "": Text {
                text: root.city.detail;
                color: root.city.selected ? root.theme.on-secondary-container.transparentize(25%) : root.theme.on-surface-variant;
                font-size: 13px; wrap: word-wrap;
            }
        }
        if root.city.selected: Text { text: "✓"; color: root.theme.primary; font-size: 18px; font-weight: 600; vertical-alignment: center; }
        if root.removable: Rectangle {
            width: 48px;
            // Drawn rather than a "✕" glyph, which Android's font lacks.
            Path {
                width: 12px; height: 12px;
                viewbox-width: 12; viewbox-height: 12;
                fit: fill;
                commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                stroke: remove-touch.pressed ? root.theme.on-surface : root.theme.on-surface-variant;
                stroke-width: 2px;
            }
            remove-touch := TouchArea { clicked => { root.remove(); } }
        }
    }
}

/// Full-screen list of saved cities with a search bar to add new ones.
component CityPicker inherits Rectangle {
    in property <[CityItem]> cities;
    in property <[CityItem]> results;
    in property <string> search-status;
    in property <bool> can-locate;
    in property <Theme> theme;
    in property <Labels> labels;
    callback close();
    callback locate();
    callback search(string);
    callback add-city(int);
    callback select-city(int);
    callback remove-city(int);

    background: root.theme.surface;
    // Swallow taps so they don't reach the screen underneath.
    TouchArea { }

    VerticalLayout {
        padding: 16px;
        padding-top: 44px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 8px;
            // Material 3 search bar.
            Rectangle {
                height: 52px;
                border-radius: 4px;
                background: transparent;
                border-width: input.has-focus ? 2px : 1px;
                border-color: input.has-focus ? root.theme.primary : root.theme.on-surface;
                // Back while typing closes the picker too (keys go to the
                // focused field first, then up to here).
                FocusScope {
                    key-pressed(e) => {
                        if (e.text == Key.Back || e.text == Key.Escape) {
                            root.close();
                            return accept;
                        }
                        return reject;
                    }
                input := TextInput {
                    x: 22px;
                    width: parent.width - 44px;
                    vertical-alignment: center;
                    color: root.theme.on-surface;
                    font-size: 17px;
                    single-line: true;
                    selection-background-color: root.theme.primary-container;
                    edited => { root.search(self.text); }
                }
                }
                if input.text == "": Text {
                    x: 22px;
                    text: root.labels.search;
                    color: root.theme.on-surface-variant;
                    font-size: 17px;
                }
            }
            Rectangle {
                width: 72px;
                Text { text: root.labels.done.to-uppercase(); color: root.theme.primary; font-size: 12px; font-weight: 600; letter-spacing: 1.6px; }
                TouchArea { clicked => { root.close(); } }
            }
        }

        if root.search-status != "": Text {
            text: root.search-status;
            color: root.theme.on-surface-variant;
            font-size: 14px;
            wrap: word-wrap;
        }

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 4px;
                if input.text == "" && root.can-locate: Rectangle {
                    height: 52px;
                    border-radius: 4px;
                    background: locate-touch.pressed ? root.theme.primary-container.darker(8%) : root.theme.primary-container;
                    Text { text: "📍  " + root.labels.use-location; color: root.theme.on-primary-container; font-size: 16px; font-weight: 500; }
                    locate-touch := TouchArea { clicked => { root.locate(); } }
                }
                if input.text == "" && root.can-locate: Rectangle { height: 12px; }
                if input.text == "": Text {
                    text: root.labels.saved-cities; color: root.theme.primary; font-size: 14px; font-weight: 600;
                }
                if input.text == "": VerticalLayout {
                    spacing: 4px;
                    for c[i] in root.cities: CityRow {
                        city: c;
                        theme: root.theme;
                        removable: root.cities.length > 1;
                        clicked => { root.select-city(i); }
                        remove => { root.remove-city(i); }
                    }
                }
                if input.text != "": VerticalLayout {
                    spacing: 4px;
                    for c[i] in root.results: CityRow {
                        city: c;
                        theme: root.theme;
                        clicked => { root.add-city(i); }
                    }
                }
            }
        }
    }
}

/// One colour of the rain scale, with its name.
component RainChip inherits HorizontalLayout {
    in property <color> colour;
    in property <string> label;
    in property <Theme> theme;
    spacing: 6px;
    Rectangle { width: 10px; height: 10px; y: (parent.height - self.height) / 2; border-radius: 1px; background: root.colour; }
    Text { text: root.label.to-uppercase(); color: root.theme.on-surface-variant; font-size: 10.5px; letter-spacing: 1.2px; vertical-alignment: center; }
}

/// The rain radar: the last two hours over a map, then the next three hours
/// forecast, the place in the middle; a timeline to move through them.
component RadarScreen inherits Rectangle {
    in property <Theme> theme;
    in property <Labels> labels;
    in property <Nowcast> nowcast;
    in property <image> map;
    in property <image> rain;
    in property <string> time;
    in property <string> status;
    in property <float> marker-x;
    in property <float> marker-y;
    in property <bool> playing;
    in property <bool> forecast;
    in property <bool> wide;
    in property <int> count;
    in property <int> index;
    in property <int> now;
    in property <string> first-time;
    in property <string> last-time;
    callback close();
    callback toggle();
    callback seek(int);
    callback set-wide(bool);
    background: root.theme.surface;
    TouchArea { }
    Flickable {
        content-width: self.width;
        content-height: page.preferred-height;
        page := VerticalLayout {
            width: parent.width;
            padding: 16px;
            padding-top: 44px;
            padding-bottom: 32px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                padding-left: 8px;
                Text { text: root.labels.radar; color: root.theme.on-surface; font-family: Type.serif; font-size: 32px; vertical-alignment: center; }
                Rectangle {
                    width: 72px;
                    height: 48px;
                    Text { text: root.labels.done.to-uppercase(); color: root.theme.primary; font-size: 12px; font-weight: 600; letter-spacing: 1.6px; }
                    TouchArea { clicked => { root.close(); } }
                }
            }
            // The map, taller than wide (the square tiles are cropped at the
            // sides): Region/Wide and the time over it.
            map-box := Rectangle {
                height: min(self.width * 1.3, root.height - 260px);
                border-radius: 4px;
                border-width: 1px;
                border-color: root.theme.outline-variant;
                clip: true;
                background: root.theme.surface-container;
                // Square images as tall as the box, centred.
                property <length> side: max(self.width, self.height);
                Image { x: (parent.width - parent.side) / 2; y: (parent.height - parent.side) / 2; width: parent.side; height: parent.side; source: root.map; image-fit: fill; }
                Image { x: (parent.width - parent.side) / 2; y: (parent.height - parent.side) / 2; width: parent.side; height: parent.side; source: root.rain; image-fit: fill; opacity: 0.85; }
                Rectangle {
                    x: (parent.width - parent.side) / 2 + parent.side * root.marker-x - self.width / 2;
                    y: (parent.height - parent.side) / 2 + parent.side * root.marker-y - self.height / 2;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: #1c1a17;
                    border-width: 3px;
                    border-color: #ffffff;
                }
                TouchArea { clicked => { root.toggle(); } }
                if root.time != "": Rectangle {
                    x: 12px;
                    y: parent.height - self.height - 12px;
                    width: time-row.preferred-width;
                    height: 30px;
                    border-radius: 2px;
                    background: root.theme.surface.with-alpha(0.92);
                    time-row := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;
                        Path {
                            width: 10px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 10;
                            viewbox-height: 12;
                            fill: root.theme.on-surface;
                            commands: root.playing ? "M 0 0 L 10 6 L 0 12 Z" : "M 0 0 L 3.5 0 L 3.5 12 L 0 12 Z M 6.5 0 L 10 0 L 10 12 L 6.5 12 Z";
                        }
                        Text {
                            text: root.time.to-uppercase();
                            color: root.forecast ? root.theme.primary : root.theme.on-surface;
                            font-size: 12px;
                            font-weight: 600;
                            letter-spacing: 1.2px;
                            vertical-alignment: center;
                        }
                    }
                }
                // Region / Wide, a small switch in the corner.
                Rectangle {
                    x: parent.width - self.width - 12px;
                    y: 12px;
                    width: zoom-row.preferred-width;
                    height: 30px;
                    border-radius: 2px;
                    background: root.theme.surface.with-alpha(0.92);
                    zoom-row := HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        for option[i] in [root.labels.radar-region, root.labels.radar-wide]: Rectangle {
                            property <bool> on: (i == 1) == root.wide;
                            width: zoom-text.preferred-width + 18px;
                            border-radius: 1px;
                            background: self.on ? root.theme.on-surface : transparent;
                            zoom-text := Text {
                                text: option.to-uppercase();
                                color: parent.on ? root.theme.surface : root.theme.on-surface-variant;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 1.2px;
                            }
                            TouchArea { y: -8px; height: parent.height + 16px; clicked => { root.set-wide(i == 1); } }
                        }
                    }
                }
            }
            if root.nowcast.summary != "": Text {
                text: root.nowcast.summary;
                color: root.theme.on-surface;
                font-family: Type.serif;
                font-size: 20px;
                wrap: word-wrap;
            }
            // Timeline: one track, the radar's part then the forecast's
            // (lighter), filled up to the frame shown, with a thumb to drag.
            // Over the forecast's first frames, the next 2 hours' rain.
            if root.count > 1: line := Rectangle {
                property <float> step: 1 / root.count;
                property <length> rain-room: root.nowcast.wet ? 28px : 0px;
                height: self.rain-room + 46px;
                for bar[b] in root.nowcast.bars: Rectangle {
                    x: parent.width * (root.now + 1 + b) * parent.step + 1px;
                    width: parent.width * parent.step - 2px;
                    visible: root.nowcast.wet && root.now + 1 + b < root.count;
                    y: parent.rain-room - 4px - self.height;
                    height: bar.wet ? max(3px, bar.height * (parent.rain-room - 6px)) : 0px;
                    border-radius: 1px;
                    background: root.theme.primary.transparentize(30%);
                }
                Rectangle {
                    y: line.rain-room + 9px;
                    height: 2px;
                    // The radar's part a rule, the forecast's a fainter one.
                    background: root.theme.on-surface;
                    Rectangle {
                        x: parent.width * (root.now + 1) * line.step;
                        width: parent.width - self.x;
                        background: root.theme.outline-variant;
                    }
                    // "Now": a tick across the rule.
                    Rectangle {
                        x: parent.width * (root.now + 0.5) * line.step - 0.5px;
                        y: -6px;
                        width: 1px;
                        height: 14px;
                        background: root.theme.on-surface;
                    }
                    // The frame shown.
                    Rectangle {
                        x: parent.width * (root.index + 0.5) * line.step - self.width / 2;
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: root.theme.primary;
                        border-width: 3px;
                        border-color: root.theme.surface;
                    }
                }
                // The first and last times give way to "Now" when it's close.
                first-label := Text {
                    x: 0;
                    y: parent.rain-room + 26px;
                    text: root.first-time;
                    color: root.theme.on-surface-variant;
                    font-size: 12px;
                    visible: self.width + 8px < now-label.x;
                }
                now-label := Text {
                    x: max(0px, min(parent.width - self.width, parent.width * (root.now + 0.5) / root.count - self.width / 2));
                    y: parent.rain-room + 26px;
                    text: root.labels.now;
                    color: root.theme.on-surface;
                    font-size: 12px;
                    font-weight: 600;
                }
                last-label := Text {
                    x: parent.width - self.width;
                    y: parent.rain-room + 26px;
                    text: root.last-time;
                    color: root.theme.on-surface-variant;
                    font-size: 12px;
                    visible: now-label.x + now-label.width + 8px < self.x;
                }
                timeline := TouchArea {
                    function pick() {
                        root.seek(floor(max(0, min(0.999, self.mouse-x / self.width)) * root.count));
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { self.pick(); }
                    }
                    moved => { if (self.pressed) { self.pick(); } }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                alignment: center;
                RainChip { theme: root.theme; colour: #48a8f0; label: root.labels.rain-light; }
                RainChip { theme: root.theme; colour: #2353c8; label: root.labels.rain-moderate; }
                RainChip { theme: root.theme; colour: #f7d23e; label: root.labels.rain-heavy; }
                RainChip { theme: root.theme; colour: #d7263d; label: root.labels.rain-violent; }
            }
            Text { text: root.status; color: root.theme.on-surface-variant; font-size: 13px; wrap: word-wrap; }
            Text { text: root.labels.radar-credit; color: root.theme.on-surface-variant; font-size: 11px; wrap: word-wrap; }
        }
    }
}

/// Full-screen list of weather models to choose from.
component SourcePicker inherits Rectangle {
    in property <[CityItem]> sources;
    in property <Theme> theme;
    in property <Labels> labels;
    in property <string> accuracy-note;
    callback close();
    callback select(int);
    background: root.theme.surface;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        padding-top: 44px;
        spacing: 12px;
        HorizontalLayout {
            padding-left: 8px;
            Text { text: root.labels.data-source; color: root.theme.on-surface; font-family: Type.serif; font-size: 30px; vertical-alignment: center; }
            Rectangle {
                width: 72px;
                height: 48px;
                Text { text: root.labels.done.to-uppercase(); color: root.theme.primary; font-size: 12px; font-weight: 600; letter-spacing: 1.6px; }
                TouchArea { clicked => { root.close(); } }
            }
        }
        Text {
            text: root.labels.data-source-help;
            color: root.theme.on-surface-variant;
            font-size: 14px;
            wrap: word-wrap;
        }
        if root.accuracy-note != "": Text {
            text: root.accuracy-note;
            color: root.theme.on-surface-variant;
            font-size: 13px;
            wrap: word-wrap;
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 4px;
                for s[i] in root.sources: CityRow {
                    city: s;
                    theme: root.theme;
                    clicked => { root.select(i); }
                }
            }
        }
    }
}

// ── The main window ─────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "Météo";
    default-font-family: "Lexend";
    // Back (Android's gesture or button; Escape on the desktop) closes what's
    // open, one layer at a time; with nothing open it leaves the app.
    forward-focus: back-keys;
    back-keys := FocusScope {
        key-pressed(e) => {
            if (e.text != Key.Back && e.text != Key.Escape) {
                return reject;
            }
            if (root.radar-open) {
                root.radar-open = false;
            } else if (root.source-open) {
                root.source-open = false;
            } else if (root.picker-open) {
                root.picker-open = false;
            } else if (root.settings-open) {
                root.settings-open = false;
            } else {
                return reject;
            }
            return accept;
        }
    }
    // The city search field takes the focus; give it back when it closes.
    changed picker-open => {
        if (!self.picker-open) {
            back-keys.focus();
        }
    }
    preferred-width: 400px;
    preferred-height: 820px;

    in property <string> city: "—";
    in property <string> temperature: "--°";
    in property <string> condition: "Loading…";
    in property <Details> details;
    // "Updated 5 min ago", in the footer.
    in property <string> updated;
    in property <[DayItem]> days;
    in property <string> error;
    // "Offline · updated 2 h ago" when a refresh failed; empty otherwise.
    in property <string> status;
    in property <[CityItem]> cities;
    in property <[CityItem]> results;
    in property <string> search-status;
    in-out property <bool> picker-open;
    /// How many cities are saved, and which is shown (the dots under the city).
    in property <int> city-count;
    in property <int> city-index;
    /// Swiped to the next (1) or previous (-1) saved city.
    callback swipe-city(int);
    /// A short vibration (pull-to-refresh reached).
    callback haptic();
    // Which day's hour-by-hour chart is open (-1: none); Today by default.
    in-out property <int> open-day: 0;
    /// The open day's hours are being swiped (see DayChart.panning).
    property <bool> chart-panning;
    // A day closed mid-swipe mustn't leave the page unable to scroll.
    changed open-day => { self.chart-panning = false; }
    in property <string> source-name: "Best match";
    in property <[CityItem]> sources;
    in-out property <bool> source-open;
    in-out property <bool> radar-open;
    in property <image> radar-map;
    in property <image> radar-rain;
    in property <string> radar-time;
    in property <string> radar-status;
    in property <float> radar-marker-x: 0.5;
    in property <float> radar-marker-y: 0.5;
    in property <bool> radar-playing;
    in property <bool> radar-forecast;
    in property <bool> radar-wide;
    in property <int> radar-count;
    in property <int> radar-index;
    in property <int> radar-now;
    in property <string> radar-start;
    in property <string> radar-end;
    callback radar-seek(int);
    callback radar-set-wide(bool);
    callback radar-opened();
    callback radar-closed();
    callback radar-toggle();
    changed radar-open => { if (self.radar-open) { root.radar-opened(); } else { root.radar-closed(); } }
    /// False for the first frame: the open day's chart joins right after,
    /// so the top of the page shows sooner.
    in-out property <bool> settled;
    in property <string> accuracy-note;
    callback sources-opened();
    changed source-open => { if (self.source-open) { root.sources-opened(); } }
    in property <bool> can-locate;
    in property <Nowcast> nowcast;
    in property <[WarningItem]> warnings;
    in property <AirInfo> air;
    // "3° warmer than usual"; empty if unknown.
    in property <string> vs-normal;
    // Settings (see app/src/lib.rs).
    in-out property <bool> settings-open;
    in property <int> units-index;
    in property <int> colors-index;
    in property <int> widget-transparency-index;
    in property <int> widget-colors-index;
    in property <int> language-index;
    in property <bool> morning-summary;
    in property <bool> rain-alerts;
    in property <bool> warning-alerts;
    in property <bool> temperature-alerts;
    in property <bool> notifications-blocked;
    in property <bool> can-use-wallpaper;
    // Pull to refresh: true while a refresh started that way is running.
    in-out property <bool> refreshing;
    in property <Labels> labels: {
        forecast: "7-day forecast", feels-like: "Feels like", humidity: "Humidity",
        wind: "Wind", sun: "Sun", uv-index: "UV index",
        pressure: "Pressure", refresh: "Refresh", data-source: "Data source", data-source-help: "",
        search: "Search for a city", done: "Done", use-location: "Use my location", saved-cities: "Saved cities",
    };
    in property <Theme> theme: {
        primary: #3c5fa8, on-primary: #ffffff,
        primary-container: #d9e2ff, on-primary-container: #001944,
        secondary-container: #dce2f9, on-secondary-container: #141b2c,
        tertiary-container: #fbd7fc, on-tertiary-container: #29132d,
        surface: #faf9ff, surface-container: #ededf4, surface-container-high: #e3e4ec,
        on-surface: #1a1b21, on-surface-variant: #44464f, outline-variant: #c5c6d0,
        bg-top: #f8e9d2, bg-bottom: #f2d3a6, particle: #3d7bd9, cloud: #ffffff,
    };

    // The theme as shown: each colour fades to the new one (another city,
    // or the weather or time of day changing) instead of snapping.
    property <color> t-primary: root.theme.primary;
    property <color> t-on-primary: root.theme.on-primary;
    property <color> t-primary-container: root.theme.primary-container;
    property <color> t-on-primary-container: root.theme.on-primary-container;
    property <color> t-secondary-container: root.theme.secondary-container;
    property <color> t-on-secondary-container: root.theme.on-secondary-container;
    property <color> t-tertiary-container: root.theme.tertiary-container;
    property <color> t-on-tertiary-container: root.theme.on-tertiary-container;
    property <color> t-surface: root.theme.surface;
    property <color> t-surface-container: root.theme.surface-container;
    property <color> t-surface-container-high: root.theme.surface-container-high;
    property <color> t-on-surface: root.theme.on-surface;
    property <color> t-on-surface-variant: root.theme.on-surface-variant;
    property <color> t-outline-variant: root.theme.outline-variant;
    property <color> t-bg-top: root.theme.bg-top;
    property <color> t-bg-bottom: root.theme.bg-bottom;
    property <color> t-particle: root.theme.particle;
    property <color> t-cloud: root.theme.cloud;
    animate t-primary, t-on-primary, t-primary-container, t-on-primary-container, t-secondary-container, t-on-secondary-container, t-tertiary-container, t-on-tertiary-container, t-surface, t-surface-container, t-surface-container-high, t-on-surface, t-on-surface-variant, t-outline-variant, t-bg-top, t-bg-bottom, t-particle, t-cloud { duration: 800ms; easing: ease-in-out; }
    property <Theme> shown-theme: {
        primary: root.t-primary,
        on-primary: root.t-on-primary,
        primary-container: root.t-primary-container,
        on-primary-container: root.t-on-primary-container,
        secondary-container: root.t-secondary-container,
        on-secondary-container: root.t-on-secondary-container,
        tertiary-container: root.t-tertiary-container,
        on-tertiary-container: root.t-on-tertiary-container,
        surface: root.t-surface,
        surface-container: root.t-surface-container,
        surface-container-high: root.t-surface-container-high,
        on-surface: root.t-on-surface,
        on-surface-variant: root.t-on-surface-variant,
        outline-variant: root.t-outline-variant,
        bg-top: root.t-bg-top,
        bg-bottom: root.t-bg-bottom,
        particle: root.t-particle,
        cloud: root.t-cloud,
    };

    // The quiet landscape (core/src/landscape.rs), coloured by the palette.
    in property <[LandLayer]> land-layers;
    in property <color> ground: #d0c8b8;
    in property <string> icon-kind: "clear-day";
    // "Feels like 9° · Day 15° · Night 10°".
    in property <string> subline;
    in property <string> advice;

    // Animated weather (see animation.rs).
    in property <string> rain-far;
    in property <string> rain-near;
    in property <string> splashes;
    in property <string> snow-small;
    in property <string> snow-large;
    in property <string> stars-dim;
    in property <string> stars-mid;
    in property <string> stars-bright;
    in property <string> bolt;
    in property <float> flash;
    in property <[CloudItem]> clouds;
    in property <[FogItem]> fog;

    callback refresh();
    callback open-url(string);
    callback locate();
    callback search(string);
    callback add-city(int);
    callback select-city(int);
    callback remove-city(int);
    callback select-source(int);
    callback set-units(int);
    callback set-colors(int);
    callback set-widget-transparency(int);
    callback set-widget-colors(int);
    callback set-language(int);
    callback set-morning-summary(bool);
    callback set-rain-alerts(bool);
    callback set-warning-alerts(bool);
    callback set-temperature-alerts(bool);
    callback open-notification-settings();
    callback test-notifications();

    // The page: a faint wash from the top into the paper.
    background: @linear-gradient(180deg, root.shown-theme.bg-top 0%, root.shown-theme.bg-bottom 45%);

    // ── Behind the text: stars (at night), a few clouds ──
    Particles { d: root.stars-dim; stroke: root.shown-theme.on-surface.transparentize(75%); stroke-width: 1.5px; }
    Particles { d: root.stars-mid; stroke: root.shown-theme.on-surface.transparentize(55%); stroke-width: 2px; }
    Particles { d: root.stars-bright; stroke: root.shown-theme.on-surface.transparentize(25%); stroke-width: 2.5px; }
    // Faint: they drift behind the headline.
    for c in root.clouds: Cloud { cloud: c; tint: root.shown-theme.cloud; opacity: 0.5; }
    for f in root.fog: Rectangle {
        x: f.x * 1px; y: f.y * 1px;
        width: f.width * 1px; height: f.height * 1px;
        border-radius: self.height / 2;
        background: root.shown-theme.cloud;
        opacity: f.opacity;
    }
    // Rain and snow: fine strokes in the quiet ink.
    Particles { d: root.rain-far; stroke: root.shown-theme.particle.transparentize(70%); stroke-width: 0.8px; }
    Particles { d: root.rain-near; stroke: root.shown-theme.particle.transparentize(45%); stroke-width: 1.2px; }
    Particles { d: root.snow-small; stroke: root.shown-theme.particle.transparentize(35%); stroke-width: 3px; }
    Particles { d: root.snow-large; stroke: root.shown-theme.particle.transparentize(10%); stroke-width: 5px; }
    Particles { d: root.bolt; stroke: root.shown-theme.primary.transparentize(60%); stroke-width: 8px; stroke-line-join: round; }
    Particles { d: root.bolt; stroke: root.shown-theme.primary; stroke-width: 2px; stroke-line-join: round; }
    if root.flash > 0.01: Rectangle { background: root.shown-theme.on-surface; opacity: root.flash * 0.25; }

    // ── The page: masthead, headline, landscape, then the sections on paper ──
    // Where drops land: the top of the paper below the landscape.
    out property <[length]> surface-tops: [sheet.absolute-position.y];
    in property <float> compass-heading;
    property <length> scroll: max(0px, -content-flick.content-y - root.pull-zone);

    // Pull to refresh with plain scrolling: the content starts with a strip
    // (`pull-zone`) scrolled just out of view. Pulling down from the top
    // reveals it; once it's fully shown and has stopped moving, the timer
    // refreshes and scrolls it away again. (Slint's Flickable has no
    // overscroll, and a gesture handler around it delays its touches.)
    property <length> pull-zone: 72px;
    property <length> pull: max(0px, content-flick.content-y + root.pull-zone);
    property <length> last-pull;
    // A small tick when the pull goes far enough to refresh.
    property <bool> pull-armed;
    changed pull => {
        if (self.pull > self.pull-zone - 16px && !self.pull-armed) {
            self.pull-armed = true;
            root.haptic();
        } else if (self.pull < 4px) {
            self.pull-armed = false;
        }
    }
    pull-timer := Timer {
        interval: 200ms;
        running: root.pull > 1px;
        triggered => {
            // Still moving: wait. Settled: refresh if fully pulled, then hide the strip.
            if (abs(root.pull - root.last-pull) > 1px) {
                root.last-pull = root.pull;
            } else {
                if (root.pull > root.pull-zone - 16px && !root.refreshing) {
                    root.refreshing = true;
                    root.refresh();
                }
                content-flick.content-y = -root.pull-zone;
                root.last-pull = 0px;
            }
        }
    }
    // Explicit size, so the content's height (which depends on the window's)
    // doesn't feed back into the window's own size constraints.
    content-flick := Flickable {
        x: 0; y: 0;
        interactive: !root.chart-panning;
        width: root.width;
        height: root.height;
        content-width: self.width;
        content-height: content.preferred-height;
        // Start with the pull strip hidden above the top.
        init => { self.content-y = -root.pull-zone; }
        content := VerticalLayout {
            width: parent.width;
            spacing: 0px;

            // The pull strip: an arrow that turns to the accent once pulled far enough.
            Rectangle {
                height: root.pull-zone;
                Path {
                    y: parent.height - 36px;
                    width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    fit: fill;
                    commands: "M 19 12 A 7 7 0 1 1 16.5 6.6 M 16.5 2.5 L 16.5 6.6 L 12.4 6.6";
                    stroke: root.pull > root.pull-zone - 16px ? root.shown-theme.primary : root.shown-theme.on-surface-variant;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }

            // Masthead and headline. Swipe sideways for the next or previous
            // saved city.
            Rectangle {
                height: hero.preferred-height;
                swipe := SwipeGestureHandler {
                    handle-swipe-left: root.city-count > 1;
                    handle-swipe-right: root.city-count > 1;
                    property <length> dx: self.swiping ? self.current-position.x - self.pressed-position.x : 0;
                    swiped => {
                        if (self.current-position.x - self.pressed-position.x < -60px) {
                            root.swipe-city(1);
                        } else if (self.current-position.x - self.pressed-position.x > 60px) {
                            root.swipe-city(-1);
                        }
                    }
                hero := VerticalLayout {
                    // Follows the finger, a little damped, and fades.
                    x: swipe.dx * 0.6;
                    animate x { duration: 220ms; easing: ease-out; }
                    opacity: 1 - min(0.6, abs(swipe.dx) / 400px);
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 52px;
                    padding-bottom: 8px;
                    spacing: 0px;
                    alignment: start;
                    // Masthead: the city (tap to switch or add), the saved
                    // cities as dots, settings.
                    HorizontalLayout {
                        height: 44px;
                        spacing: 10px;
                        Rectangle {
                            width: city-row.preferred-width;
                            city-row := HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.city.to-uppercase();
                                    color: root.shown-theme.on-surface;
                                    font-size: 13px; font-weight: 600;
                                    letter-spacing: 1.8px;
                                    vertical-alignment: center;
                                }
                                // Chevron drawn as a path ("▾" is missing from Android's font).
                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 10px; height: 6px;
                                        viewbox-width: 14; viewbox-height: 8;
                                        fit: fill;
                                        commands: "M 1 1 L 7 7 L 13 1";
                                        stroke: root.shown-theme.on-surface;
                                        stroke-width: 1.6px;
                                    }
                                }
                            }
                            city-touch := TouchArea { x: -10px; width: parent.width + 20px; clicked => { root.picker-open = true; } }
                        }
                        if root.city-count > 1: HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            for i in root.city-count: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px; height: 5px; border-radius: 2.5px;
                                    background: i == root.city-index ? root.shown-theme.on-surface : root.shown-theme.on-surface.transparentize(70%);
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Settings: a "tune" icon (two sliders).
                        Rectangle {
                            width: 40px;
                            background: gear-touch.pressed ? root.shown-theme.surface-container-high : transparent;
                            Path {
                                width: 20px; height: 20px;
                                viewbox-width: 20; viewbox-height: 20;
                                fit: fill;
                                commands: "M 3 6 L 17 6 M 3 14 L 17 14 M 7 3.5 L 7 8.5 M 13 11.5 L 13 16.5";
                                stroke: root.shown-theme.on-surface;
                                stroke-width: 1.6px;
                                stroke-line-cap: round;
                            }
                            gear-touch := TouchArea { x: -4px; width: parent.width + 8px; clicked => { root.settings-open = true; } }
                        }
                    }
                    Rectangle { height: 1.5px; background: root.shown-theme.on-surface; }
                    if root.status != "": Text {
                        text: root.status.to-uppercase();
                        color: root.shown-theme.primary;
                        font-size: 10.5px; font-weight: 600;
                        letter-spacing: 1.4px;
                    }
                    // The temperature, large, and the weather beside it.
                    HorizontalLayout {
                        padding-top: 16px;
                        spacing: 8px;
                        Text {
                            text: root.temperature;
                            color: root.shown-theme.on-surface;
                            font-family: Type.serif;
                            font-size: 128px;
                            font-weight: 300;
                            letter-spacing: -3px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            WeatherIcon {
                                width: 64px; height: 64px;
                                kind: root.icon-kind;
                                ink: root.shown-theme.on-surface;
                                cloud-fill: root.shown-theme.bg-bottom;
                            }
                        }
                    }
                    // The headline: the weather, then what to do about it.
                    Text {
                        text: root.condition;
                        color: root.shown-theme.on-surface;
                        font-family: Type.serif;
                        font-italic: true;
                        font-size: 30px;
                        wrap: word-wrap;
                    }
                    if root.advice != "": Text {
                        text: root.advice;
                        color: root.shown-theme.primary;
                        font-family: Type.serif;
                        font-italic: true;
                        font-size: 22px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 8px; }
                    Text {
                        text: root.subline;
                        color: root.shown-theme.on-surface-variant; font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.vs-normal != "": Text {
                        text: root.vs-normal.to-uppercase();
                        color: root.shown-theme.on-surface-variant;
                        font-size: 10.5px; font-weight: 500;
                        letter-spacing: 1.4px;
                    }
                    if root.error != "": Text {
                        text: root.error; color: root.shown-theme.on-surface; font-size: 13px; wrap: word-wrap;
                    }
                }
                }
            }

            // The landscape, a band across the page; the paper slides over it.
            Landscape {
                height: root.width * 0.46;
                layers: root.land-layers;
                scroll: root.scroll;
            }

            // The sections, on paper. They fade in once the first frame is up.
            // (Not a slide: an animated `y` on this layout stops the page
            // from scrolling with Slint 1.19.)
            sheet := Rectangle {
                background: root.shown-theme.bg-bottom;
                // At least a screen: the page must always scroll past the
                // pull strip above it.
                min-height: root.height;
                opacity: root.settled ? 1 : 0;
                animate opacity { duration: 450ms; easing: ease-out; }
                VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 20px;
                    // Room above Android's gesture bar.
                    padding-bottom: 48px;
                    spacing: 30px;
                    alignment: start;
                    // Official warnings first: the most important thing to see.
                    if root.warnings.length > 0: WarningsCard {
                        warnings: root.warnings;
                        source: root.labels.warnings-source;
                        open => { root.open-url("https://meteoalarm.org"); }
                    }
                    if root.nowcast.summary != "": NowcastCard {
                        nowcast: root.nowcast;
                        title: root.labels.next-hours;
                        link: root.labels.radar-link;
                        theme: root.shown-theme;
                        clicked => { root.radar-open = true; }
                    }

                    // The week; a day opens hour by hour.
                    VerticalLayout {
                        spacing: 0px;
                        SectionHead { theme: root.shown-theme; text: root.labels.forecast; }
                        for d[i] in root.days: VerticalLayout {
                            DayRow {
                                day: d;
                                theme: root.shown-theme;
                                open: root.open-day == i;
                                last: i == root.days.length - 1 && root.open-day != i;
                                clicked => { root.open-day = root.open-day == i ? -1 : i; }
                            }
                            if root.open-day == i && root.settled: DayChart {
                                day: d; theme: root.shown-theme;
                                changed panning => { root.chart-panning = self.panning; }
                            }
                            if root.open-day == i && i < root.days.length - 1: Rectangle {
                                height: 1px;
                                background: root.shown-theme.outline-variant;
                            }
                        }
                    }

                    // Details, two columns.
                    VerticalLayout {
                        spacing: 0px;
                        SectionHead { theme: root.shown-theme; text: root.labels.details; }
                        HorizontalLayout {
                            spacing: 18px;
                            DetailCell {
                                theme: root.shown-theme; label: root.labels.wind;
                                value: root.details.wind-speed + " " + root.details.wind-unit;
                                note: root.details.wind-gusts == "" ? root.details.wind-from : root.details.wind-from + " · " + root.details.wind-gusts;
                                arrow: root.details.wind-arrow-path;
                                heading: root.compass-heading;
                            }
                            DetailCell { theme: root.shown-theme; label: root.labels.feels-like; value: root.details.feels-like; note: root.details.feels-note; }
                        }
                        Rectangle { height: 1px; background: root.shown-theme.outline-variant; }
                        HorizontalLayout {
                            spacing: 18px;
                            DetailCell { theme: root.shown-theme; label: root.labels.humidity; value: root.details.humidity; note: root.details.dew-point; }
                            DetailCell { theme: root.shown-theme; label: root.labels.uv-index; value: root.details.uv; note: root.details.uv-level; }
                        }
                        Rectangle { height: 1px; background: root.shown-theme.outline-variant; }
                        HorizontalLayout {
                            spacing: 18px;
                            DetailCell { theme: root.shown-theme; label: root.labels.pressure; value: root.details.pressure; note: root.details.pressure-note; }
                            DetailCell { theme: root.shown-theme; label: root.labels.air-quality; value: root.air.aqi; note: root.air.aqi-level; }
                        }
                        Rectangle { height: 1px; background: root.shown-theme.outline-variant; }
                        HorizontalLayout {
                            spacing: 18px;
                            DetailCell {
                                theme: root.shown-theme; label: root.labels.pollen; value: root.air.pollen;
                                note: root.air.pollen-outlook == "" ? root.air.pollen-level : root.air.pollen-level + "\n" + root.air.pollen-outlook;
                            }
                            DetailCell { theme: root.shown-theme; label: root.labels.sun; value: root.details.sunrise + " – " + root.details.sunset; note: root.details.daylight; }
                        }
                    }

                    // Colophon: where the data comes from, when it was
                    // updated, and the credit Open-Meteo's licence asks for.
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle { height: 1.5px; background: root.shown-theme.on-surface; }
                        Rectangle {
                            height: 56px;
                            background: source-touch.pressed ? root.shown-theme.surface-container-high : transparent;
                            HorizontalLayout {
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: root.labels.data-source.to-uppercase(); color: root.shown-theme.on-surface-variant; font-size: 10.5px; letter-spacing: 1.4px; }
                                    Text { text: root.source-name + " · Open-Meteo"; color: root.shown-theme.on-surface; font-family: Type.serif; font-size: 18px; }
                                }
                                Text { text: "›"; color: root.shown-theme.primary; font-size: 20px; vertical-alignment: center; horizontal-alignment: right; }
                            }
                            source-touch := TouchArea { clicked => { root.source-open = true; } }
                        }
                        Rectangle { height: 1px; background: root.shown-theme.outline-variant; }
                        HorizontalLayout {
                            height: 44px;
                            spacing: 8px;
                            Text {
                                text: root.updated;
                                color: root.shown-theme.on-surface-variant; font-size: 12px;
                                vertical-alignment: center; overflow: elide;
                            }
                            Rectangle {
                                width: refresh-text.preferred-width;
                                refresh-text := Text {
                                    text: root.labels.refresh.to-uppercase();
                                    color: refresh-touch.pressed ? root.shown-theme.on-surface : root.shown-theme.primary;
                                    font-size: 11px; font-weight: 600; letter-spacing: 1.6px;
                                }
                                refresh-touch := TouchArea { x: -12px; width: parent.width + 24px; clicked => { root.refresh(); } }
                            }
                        }
                        Rectangle {
                            height: 28px;
                            Text {
                                x: 0;
                                text: root.labels.data-credit;
                                color: credit-touch.pressed ? root.shown-theme.on-surface : root.shown-theme.on-surface-variant;
                                font-size: 11px;
                            }
                            credit-touch := TouchArea {
                                y: -9px; height: parent.height + 18px;
                                clicked => { root.open-url("https://open-meteo.com/"); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Splashes land on the cards, so they're drawn in front of them.
    Particles { d: root.splashes; stroke: root.shown-theme.particle.transparentize(20%); stroke-width: 2.5px; }

    // While a pull-started refresh runs: a pill with the arrow.
    if root.refreshing: Rectangle {
        x: (root.width - self.width) / 2;
        y: 92px;
        width: 40px; height: 40px;
        border-radius: 20px;
        background: root.shown-theme.bg-bottom;
        border-width: 1px;
        border-color: root.shown-theme.on-surface;
        Path {
            width: 22px; height: 22px;
            viewbox-width: 24; viewbox-height: 24;
            fit: fill;
            // A circular arrow.
            commands: "M 19 12 A 7 7 0 1 1 16.5 6.6 M 16.5 2.5 L 16.5 6.6 L 12.4 6.6";
            stroke: root.shown-theme.primary;
            stroke-width: 2.4px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
    }

    if root.settings-open: SettingsScreen {
        width: root.width;
        height: root.height;
        theme: root.shown-theme;
        labels: root.labels;
        units-index: root.units-index;
        colors-index: root.colors-index;
        widget-transparency-index: root.widget-transparency-index;
        widget-colors-index: root.widget-colors-index;
        language-index: root.language-index;
        morning-summary: root.morning-summary;
        rain-alerts: root.rain-alerts;
        warning-alerts: root.warning-alerts;
        temperature-alerts: root.temperature-alerts;
        notifications-blocked: root.notifications-blocked;
        can-use-wallpaper: root.can-use-wallpaper;
        source-name: root.source-name;
        close => { root.settings-open = false; }
        open-sources => { root.source-open = true; }
        set-units(i) => { root.set-units(i); }
        set-colors(i) => { root.set-colors(i); }
        set-widget-transparency(i) => { root.set-widget-transparency(i); }
        set-widget-colors(i) => { root.set-widget-colors(i); }
        set-language(i) => { root.set-language(i); }
        set-morning-summary(on) => { root.set-morning-summary(on); }
        set-rain-alerts(on) => { root.set-rain-alerts(on); }
        set-warning-alerts(on) => { root.set-warning-alerts(on); }
        set-temperature-alerts(on) => { root.set-temperature-alerts(on); }
        open-notification-settings => { root.open-notification-settings(); }
        test-notifications => { root.test-notifications(); }
    }

    if root.picker-open: CityPicker {
        width: root.width;
        height: root.height;
        cities: root.cities;
        results: root.results;
        search-status: root.search-status;
        can-locate: root.can-locate;
        theme: root.shown-theme;
        labels: root.labels;
        locate => { root.locate(); }
        close => { root.picker-open = false; root.search(""); }
        search(text) => { root.search(text); }
        add-city(i) => { root.add-city(i); self.close(); }
        select-city(i) => { root.select-city(i); self.close(); }
        remove-city(i) => { root.remove-city(i); }
    }

    if root.radar-open: RadarScreen {
        width: root.width;
        height: root.height;
        theme: root.shown-theme;
        labels: root.labels;
        map: root.radar-map;
        rain: root.radar-rain;
        time: root.radar-time;
        status: root.radar-status;
        marker-x: root.radar-marker-x;
        marker-y: root.radar-marker-y;
        playing: root.radar-playing;
        forecast: root.radar-forecast;
        wide: root.radar-wide;
        count: root.radar-count;
        index: root.radar-index;
        now: root.radar-now;
        first-time: root.radar-start;
        last-time: root.radar-end;
        nowcast: root.nowcast;
        close => { root.radar-open = false; }
        toggle => { root.radar-toggle(); }
        seek(i) => { root.radar-seek(i); }
        set-wide(w) => { root.radar-set-wide(w); }
    }

    if root.source-open: SourcePicker {
        width: root.width;
        height: root.height;
        sources: root.sources;
        accuracy-note: root.accuracy-note;
        theme: root.shown-theme;
        labels: root.labels;
        close => { root.source-open = false; }
        select(i) => { root.select-source(i); root.source-open = false; }
    }
}
