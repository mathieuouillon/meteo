// Météo — a UI whose colours follow the weather, over a quiet animated
// landscape, with drawn line icons.

import { WeatherIcon } from "icons.slint";
// Lexend (SIL Open Font License, fonts/OFL.txt), embedded in the app.
import "fonts/Lexend.ttf";
//
// All values (texts, colours, chart and landscape geometry) come ready-made
// from Rust (meteo-core); this file only lays them out.

/// Material 3 colour roles (see app/src/theme.rs).
export struct Theme {
    primary: color,
    on-primary: color,
    primary-container: color,
    on-primary-container: color,
    secondary-container: color,
    on-secondary-container: color,
    tertiary-container: color,
    on-tertiary-container: color,
    surface: color,
    surface-container: color,
    surface-container-high: color,
    on-surface: color,
    on-surface-variant: color,
    outline-variant: color,
    /// Background gradient, rain/snow streaks and clouds.
    bg-top: color,
    bg-bottom: color,
    particle: color,
    cloud: color,
}

/// Fixed texts, in the user's language (core/src/i18n.rs).
export struct Labels {
    forecast: string,
    feels-like: string,
    humidity: string,
    wind: string,
    sun: string,
    uv-index: string,
    pressure: string,
    refresh: string,
    data-credit: string,
    data-source: string,
    data-source-help: string,
    search: string,
    done: string,
    use-location: string,
    saved-cities: string,
    next-hours: string,
    air-quality: string,
    pollen: string,
    settings: string,
    units: string,
    metric: string,
    imperial: string,
    colors: string,
    colors-weather: string,
    colors-wallpaper: string,
    language: string,
    language-system: string,
    notifications: string,
    morning-summary: string,
    morning-summary-help: string,
    rain-alerts: string,
    rain-alerts-help: string,
    warning-alerts: string,
    warning-alerts-help: string,
    warnings-source: string,
}

/// The details tiles (DetailsView in core/src/view.rs).
export struct Details {
    feels-like: string,
    feels-note: string,
    humidity: string,
    dew-point: string,
    wind-speed: string,
    wind-unit: string,
    wind-gusts: string,
    wind-from: string,
    wind-arrow-path: string,
    sunrise: string,
    sunset: string,
    daylight: string,
    uv: string,
    uv-level: string,
    pressure: string,
    pressure-note: string,
}

/// One hour of a day's chart (see DayHourView in core/src/view.rs).
export struct DayHour {
    label: string,
    temperature: string,
    icon: string,
    icon-kind: string,
    precipitation: string,
    rain: string,
    rain-height: float,
    // The models' range of rain ("0.4–2.1") and its heights; empty when they agree.
    rain-range: string,
    range-low: float,
    range-high: float,
    is-now: bool,
    x: float,
    y: float,
}

export struct DayItem {
    label: string,
    icon: string,
    icon-kind: string,
    precipitation: string,
    min: string,
    max: string,
    bar-start: float,
    bar-end: float,
    rain-total: string,
    first-hour: int,
    hours: [DayHour],
    rain-peak: float,
    has-chance: bool,
    chart-width: float,
    chart-height: float,
    line-path: string,
    area-path: string,
    /// Several models' range around the curve, and how much they agree.
    band-path: string,
    agreement: string,
    has-range: bool,
}

export struct CloudItem {
    x: float,
    y: float,
    scale: float,
    opacity: float,
    dark: bool,
}

export struct FogItem {
    x: float,
    y: float,
    width: float,
    height: float,
    opacity: float,
}

/// Rain over the next 2 hours (NowcastView in core/src/view.rs).
export struct NowBar {
    label: string,
    height: float,
    wet: bool,
}

/// An official weather warning (WarningView in core/src/view.rs).
export struct WarningItem {
    title: string,
    detail: string,
    /// 1 yellow, 2 orange, 3 red.
    level: int,
}

export struct Nowcast {
    summary: string,
    wet: bool,
    bars: [NowBar],
}

/// Air quality and pollen (AirView in core/src/view.rs).
export struct AirInfo {
    aqi: string,
    aqi-level: string,
    pollen: string,
    pollen-level: string,
    /// "Sat moderate · Sun high · Mon low"; empty when nothing's coming.
    pollen-outlook: string,
}

/// One silhouette of the landscape (core/src/landscape.rs), far to near.
export struct LandLayer {
    path: string,
    color: color,
}

export struct CityItem {
    name: string,
    detail: string,
    selected: bool,
    /// The device's own position.
    device: bool,
}

// ── The scene ───────────────────────────────────────────────────────────

/// One particle layer: a path in window coordinates, drawn 1:1.
component Particles inherits Path {
    in property <string> d;
    // No size set: like most elements outside a layout, it fills its parent.
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fit: fill;
    stroke-line-cap: round;
    commands: root.d == "" ? "M 0 0" : root.d;
}

/// One soft round puff of a cloud: a blurred shadow of its own colour
/// gives it fuzzy edges.
component Puff inherits Rectangle {
    in property <color> tint;
    in property <float> k;
    border-radius: self.height / 2;
    background: @linear-gradient(180deg, root.tint 0%, root.tint.transparentize(30%) 100%);
    drop-shadow-color: root.tint;
    drop-shadow-blur: 14px * root.k;
}

/// A puffy cloud in a 180×80 box, scaled. The group opacity keeps the
/// overlapping puffs from looking darker where they overlap.
component Cloud inherits Rectangle {
    in property <CloudItem> cloud;
    in property <color> tint: white;
    x: root.cloud.x * 1px;
    y: root.cloud.y * 1px;
    width: 180px * root.cloud.scale;
    height: 80px * root.cloud.scale;
    opacity: root.cloud.opacity;
    property <float> k: root.cloud.scale;
    Puff { tint: root.tint; k: root.k; x: 15px * k; y: 40px * k; width: 150px * k; height: 38px * k; }
    Puff { tint: root.tint; k: root.k; x: 30px * k; y: 15px * k; width: 60px * k; height: self.width; }
    Puff { tint: root.tint; k: root.k; x: 70px * k; y: 0px; width: 78px * k; height: self.width; }
    Puff { tint: root.tint; k: root.k; x: 115px * k; y: 22px * k; width: 50px * k; height: self.width; }
}

/// Mountains, hills and pines, drawn in a 400×300 box scaled to the width,
/// with the ground colour continuing below to the bottom of the screen.
component Landscape inherits Rectangle {
    in property <[LandLayer]> layers;
    in property <color> ground;
    /// Where the landscape's bottom edge sits.
    in property <length> horizon;
    property <length> box-height: self.width * 0.75;
    for layer in root.layers: Path {
        x: 0;
        y: root.horizon - root.box-height;
        width: root.width;
        height: root.box-height;
        viewbox-width: 400;
        viewbox-height: 300;
        fit: fill;
        commands: layer.path == "" ? "M 0 0" : layer.path;
        fill: layer.color;
        // The layers are updated in place, so their colours fade.
        animate fill { duration: 800ms; easing: ease-in-out; }
        stroke-width: 0px;
    }
    Rectangle {
        y: root.horizon - 1px;
        height: root.height - root.horizon + 1px;
        background: root.ground;
        animate background { duration: 800ms; easing: ease-in-out; }
    }
}

// ── Material 3 pieces ───────────────────────────────────────────────────

/// A pill-shaped tonal button.
component TonalButton inherits Rectangle {
    in property <string> text;
    in property <Theme> theme;
    callback clicked();
    height: 52px;
    border-radius: self.height / 2;
    background: touch.pressed ? root.theme.secondary-container.darker(8%) : root.theme.secondary-container;
    in property <length> font-size: 16px;
    Text { text: root.text; color: root.theme.on-secondary-container; font-size: root.font-size; font-weight: 500; }
    // At least 48px to tap (Material), however small it's drawn.
    touch := TouchArea {
        y: min(0px, (root.height - 48px) / 2);
        height: max(root.height, 48px);
        clicked => { root.clicked(); }
    }
}

/// One line of the details list: an icon, what it is with a short
/// explanation under it, and the value on the right.
component DetailRow inherits Rectangle {
    in property <Theme> theme;
    in property <string> label;
    in property <string> note;
    in property <string> value;
    /// Line icon, as path commands in a 24×24 box (see `RowIcons`).
    in property <string> icon;
    /// For the wind: a small compass instead of the icon. The arrow points
    /// where the wind goes; the dial turns against the phone's heading.
    in property <string> arrow;
    in property <float> heading;
    in property <bool> last;
    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        Rectangle {
            width: 30px;
            if root.arrow == "": Path {
                width: 24px; height: 24px;
                viewbox-width: 24; viewbox-height: 24;
                fit: fill;
                commands: root.icon;
                stroke: root.theme.on-surface-variant;
                stroke-width: 1.7px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            if root.arrow != "": Rectangle {
                width: 30px; height: 30px;
                border-radius: 15px;
                border-width: 1.5px;
                border-color: root.theme.outline-variant;
                Rectangle {
                    width: 30px; height: 30px;
                    transform-rotation: -root.heading * 1deg;
                    Text { y: 1px; text: "N"; color: root.theme.on-surface-variant; font-size: 7px; font-weight: 600; }
                    Path {
                        width: 30px; height: 30px;
                        viewbox-width: 64; viewbox-height: 64;
                        fit: fill;
                        commands: root.arrow;
                        fill: root.theme.primary;
                        stroke-width: 0px;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: root.label; color: root.theme.on-surface; font-size: 14px; font-weight: 500; }
            if root.note != "": Text {
                text: root.note; color: root.theme.on-surface-variant; font-size: 12px; wrap: word-wrap;
            }
        }
        Text {
            text: root.value;
            color: root.theme.on-surface;
            font-size: 17px; font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
    if !root.last: Rectangle {
        x: 44px; y: parent.height - 1px;
        width: parent.width - 44px; height: 1px;
        background: root.theme.outline-variant;
        opacity: 0.6;
    }
}

/// The details list's icons: line drawings in a 24×24 box.
global RowIcons {
    out property <string> thermometer: "M 10 13.5 V 5 A 2 2 0 0 1 14 5 V 13.5 A 4 4 0 1 1 10 13.5 Z M 12 9 V 16";
    out property <string> droplet: "M 12 3 C 12 3 5.5 10.5 5.5 14.5 A 6.5 6.5 0 0 0 18.5 14.5 C 18.5 10.5 12 3 12 3 Z";
    out property <string> uv: "M 16 12 A 4 4 0 1 1 8 12 A 4 4 0 1 1 16 12 Z M 12 2.5 V 4.5 M 12 19.5 V 21.5 M 2.5 12 H 4.5 M 19.5 12 H 21.5 M 5.3 5.3 L 6.7 6.7 M 17.3 17.3 L 18.7 18.7 M 5.3 18.7 L 6.7 17.3 M 17.3 6.7 L 18.7 5.3";
    out property <string> pressure: "M 4.5 17 A 8 8 0 1 1 19.5 17 M 12 14 L 15.5 9 M 13 14 A 1 1 0 1 1 11 14 A 1 1 0 1 1 13 14 Z";
    out property <string> leaf: "M 5 19 C 5 10 10 5 19 5 C 19 14 14 19 5 19 Z M 5 19 L 13 11";
    out property <string> flower: "M 14 12 A 2 2 0 1 1 10 12 A 2 2 0 1 1 14 12 Z M 15 6.5 A 3 3 0 1 1 9 6.5 A 3 3 0 1 1 15 6.5 Z M 15 17.5 A 3 3 0 1 1 9 17.5 A 3 3 0 1 1 15 17.5 Z M 9.5 12 A 3 3 0 1 1 3.5 12 A 3 3 0 1 1 9.5 12 Z M 20.5 12 A 3 3 0 1 1 14.5 12 A 3 3 0 1 1 20.5 12 Z";
    out property <string> sun: "M 3 18 H 21 M 7 18 A 5 5 0 0 1 17 18 M 12 4 V 9 M 9.5 6.5 L 12 4 L 14.5 6.5 M 4.5 12.5 L 6 14 M 19.5 12.5 L 18 14";
}

/// One day of the 7-day list; tap it to open its hour-by-hour chart.
component DayRow inherits Rectangle {
    in property <DayItem> day;
    in property <bool> open;
    in property <Theme> theme;
    callback clicked();
    // Drawn once into an image and reused (text is the costliest part of a frame).
    cache-rendering-hint: true;
    height: 52px;
    border-radius: 18px;
    background: touch.pressed || root.open ? root.theme.surface-container-high : transparent;
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.day.label; width: 54px;
            color: root.theme.on-surface; font-size: 16px; font-weight: root.day.label == "Today" ? 600 : 400;
            vertical-alignment: center;
        }
        VerticalLayout {
            width: 30px;
            alignment: center;
            WeatherIcon {
                width: 30px; height: 30px;
                kind: root.day.icon-kind;
                ink: root.theme.on-surface-variant;
                cloud-fill: root.theme.surface-container;
            }
        }
        // Rain: a small tonal chip with the day's total (or the chance).
        chip := Rectangle {
            width: 62px;
            property <string> label: root.day.rain-total != "" ? root.day.rain-total : root.day.precipitation;
            if chip.label != "": Rectangle {
                y: (chip.height - self.height) / 2;
                height: 24px;
                border-radius: 12px;
                background: root.theme.primary-container;
                Text { text: chip.label; color: root.theme.on-primary-container; font-size: 12px; font-weight: 500; }
            }
        }
        Text {
            text: root.day.min; width: 30px;
            color: root.theme.on-surface-variant; font-size: 16px;
            horizontal-alignment: right; vertical-alignment: center;
        }
        // Min–max bar on the whole week's temperature scale.
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 8px;
                border-radius: 4px;
                background: root.theme.surface-container-high;
                Rectangle {
                    x: parent.width * root.day.bar-start;
                    y: 0;
                    width: max(self.height, parent.width * (root.day.bar-end - root.day.bar-start));
                    height: parent.height;
                    border-radius: 4px;
                    background: @linear-gradient(90deg, #6ec1ff 0%, #ffb84d 100%);
                }
            }
        }
        Text {
            text: root.day.max; width: 34px;
            color: root.theme.on-surface; font-size: 16px; font-weight: 600;
            horizontal-alignment: right; vertical-alignment: center;
        }
    }
}

/// A day hour by hour, shown when its row is opened: the temperature curve,
/// the weather, the chance of rain and the expected amount, scrolling
/// sideways. Rain bars share the week's scale.
component DayChart inherits Rectangle {
    in property <DayItem> day;
    in property <Theme> theme;
    /// True while a finger is moving the hours sideways. The page's vertical
    /// scrolling pauses meanwhile: otherwise it takes the swipe over as soon
    /// as the finger drifts 8px up or down, which a thumb almost always does.
    out property <bool> panning;
    property <duration> last-flick;
    // Swipe over: no movement for a moment.
    Timer {
        interval: 150ms;
        running: root.panning;
        triggered => {
            if (animation-tick() - root.last-flick > 250ms) {
                root.panning = false;
            }
        }
    }
    property <length> step: 56px;
    property <length> curve: root.day.chart-height * 1px;
    // Rows below the curve, only as tall as this day needs: the chance row
    // only if some hour has one, the bars only as tall as the wettest hour.
    property <length> bar-max: 40px;
    property <length> icon-y: root.curve + 6px;
    property <length> chance-y: root.curve + 36px;
    property <length> rain-top: root.curve + (root.day.has-chance ? 54px : 38px);
    // Room for the amount label above the tallest bar (none on a dry day).
    // Room for the amount label above the tallest bar (none on a dry day),
    // and a second line for the models' range.
    property <length> rain-room: root.day.rain-peak > 0 ? max(4px, root.day.rain-peak * root.bar-max) + (root.day.has-range ? 30px : 16px) : 3px;
    property <length> rain-base: root.rain-top + root.rain-room;
    // Room for "Models agree 82%" above the chart.
    property <length> head: root.day.agreement != "" ? 22px : 0px;
    height: root.head + root.rain-base + 32px;

    if root.day.agreement != "": Text {
        x: 10px; y: 2px;
        text: root.day.agreement;
        color: root.theme.on-surface-variant; font-size: 12px;
    }

    Flickable {
        y: root.head;
        height: parent.height - root.head;
        content-width: root.day.chart-width * 1px;
        content-height: self.height;
        flicked => {
            root.last-flick = animation-tick();
            root.panning = true;
        }
        // Open with the hour before `first-hour` at the left edge.
        content-x: -max(0, min(root.day.first-hour - 1, root.day.hours.length - floor(self.width / root.step))) * root.step;

        // The models' range, then the area under the curve, then the curve,
        // cached as one image: swiping only slides it (Skia would otherwise
        // redraw these long curves on the CPU every frame).
        Rectangle {
            x: 0; y: 0;
            width: root.day.chart-width * 1px;
            height: root.curve;
            cache-rendering-hint: true;
            if root.day.band-path != "": Path {
                x: 0; y: 0;
                width: root.day.chart-width * 1px;
                height: root.curve;
                viewbox-width: root.day.chart-width;
                viewbox-height: root.day.chart-height;
                fit: fill;
                commands: root.day.band-path;
                fill: root.theme.primary.transparentize(82%);
                stroke-width: 0px;
            }
            Path {
                x: 0; y: 0;
                width: root.day.chart-width * 1px;
                height: root.curve;
                viewbox-width: root.day.chart-width;
                viewbox-height: root.day.chart-height;
                // Map the viewbox 1:1 (the default `contain` rescales a stroked path).
                fit: fill;
                commands: root.day.area-path == "" ? "M 0 0" : root.day.area-path;
                fill: @linear-gradient(180deg, root.theme.primary.transparentize(75%) 0%, root.theme.primary.transparentize(100%) 100%);
                stroke-width: 0px;
            }
            Path {
                x: 0; y: 0;
                width: root.day.chart-width * 1px;
                height: root.curve;
                viewbox-width: root.day.chart-width;
                viewbox-height: root.day.chart-height;
                fit: fill;
                commands: root.day.line-path == "" ? "M 0 0" : root.day.line-path;
                stroke: root.theme.primary;
                stroke-width: 3px;
            }
        }

        for h in root.day.hours: column := Rectangle {
            x: h.x * 1px - root.step / 2;
            y: 0;
            width: root.step;
            height: parent.height;
            // Each hour drawn once and reused while the hours slide.
            cache-rendering-hint: true;
            property <length> bar: h.rain == "" ? 3px : max(4px, h.rain-height * root.bar-max);
            // Top of what's drawn for this hour: the bar or the models' range.
            property <length> top: h.rain-range == "" ? self.bar : max(self.bar, h.range-high * root.bar-max);
            property <bool> now: h.is-now;
            Text {
                y: h.y * 1px - 24px;
                width: parent.width;
                text: h.temperature;
                color: root.theme.on-surface; font-size: 14px; font-weight: 600;
                horizontal-alignment: center;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: h.y * 1px - self.height / 2;
                width: column.now ? 12px : 8px; height: self.width; border-radius: self.width / 2;
                background: root.theme.primary;
                border-width: column.now ? 3px : 0px;
                border-color: root.theme.surface-container;
            }
            WeatherIcon {
                x: (column.width - self.width) / 2;
                y: root.icon-y;
                width: 26px; height: 26px;
                kind: h.icon-kind;
                ink: root.theme.on-surface-variant;
                cloud-fill: root.theme.surface-container;
            }
            Text {
                y: root.chance-y;
                width: parent.width;
                text: h.precipitation; color: root.theme.on-surface-variant; font-size: 11px;
                horizontal-alignment: center;
            }
            // Rain: the amount above a bar growing up from the baseline, and
            // above that, the range the models give.
            if h.rain-range != "": Text {
                y: root.rain-base - parent.top - (h.rain == "" ? 16px : 30px);
                width: parent.width;
                text: h.rain-range; color: root.theme.on-surface-variant.transparentize(25%); font-size: 10px;
                horizontal-alignment: center;
            }
            // The models' range: a faint wider bar behind the forecast's.
            if h.rain-range != "": Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.rain-base - h.range-high * root.bar-max;
                width: 28px;
                height: max(4px, (h.range-high - h.range-low) * root.bar-max);
                border-radius: 8px;
                background: #3d8fe0.transparentize(80%);
                border-width: 1px;
                border-color: #3d8fe0.transparentize(55%);
            }
            Text {
                y: root.rain-base - parent.top - 16px;
                width: parent.width;
                text: h.rain; color: root.theme.on-surface-variant; font-size: 11px; font-weight: 500;
                horizontal-alignment: center;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.rain-base - parent.bar;
                width: 18px;
                height: parent.bar;
                border-radius: 6px;
                background: h.rain == "" ? root.theme.outline-variant : @linear-gradient(180deg, #8fd0ff 0%, #3d8fe0 100%);
            }
            // "Now" in a pill.
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.rain-base + 4px;
                width: column.now ? now-label.preferred-width + 16px : column.width;
                height: 22px;
                border-radius: 11px;
                background: column.now ? root.theme.primary : transparent;
                now-label := Text {
                    text: h.label;
                    color: column.now ? root.theme.on-primary : root.theme.on-surface-variant;
                    font-size: 12px;
                    font-weight: column.now ? 600 : 400;
                }
            }
        }
    }
}

/// Rain over the next 2 hours: a summary, and 15-minute bars when wet.
/// The official warnings: one coloured line each (yellow, orange, red), a
/// warning sign, and the source. Tapping opens MeteoAlarm.
component WarningsCard inherits Rectangle {
    in property <[WarningItem]> warnings;
    in property <string> source;
    callback open();
    border-radius: 28px;
    // The strongest level sets the card's colour.
    property <int> top: root.warnings.length > 0 ? root.warnings[0].level : 1;
    background: root.top >= 3 ? #d93a2b : root.top == 2 ? #f08a24 : #f6c945;
    property <color> ink: root.top >= 3 ? #ffffff : root.top == 2 ? #2b1400 : #2e2400;
    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        for w in root.warnings: HorizontalLayout {
            spacing: 12px;
            // A warning sign, in the line's own level colour when it differs.
            Rectangle {
                width: 26px;
                Path {
                    width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    fit: fill;
                    commands: "M 12 3 L 22 20 L 2 20 Z M 12 9 L 12 14 M 12 17 L 12 17.2";
                    stroke: w.level == root.top ? root.ink
                        : w.level == 2 ? #b85a00 : #8a6d00;
                    stroke-width: 2px;
                    stroke-line-join: round;
                    stroke-line-cap: round;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: w.title; color: root.ink; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                Text { text: w.detail; color: root.ink.transparentize(20%); font-size: 12px; }
            }
        }
        Text { text: root.source; color: root.ink.transparentize(35%); font-size: 11px; horizontal-alignment: right; }
    }
    TouchArea { clicked => { root.open(); } }
}

component NowcastCard inherits Rectangle {
    // Drawn once into an image and reused (text is the costliest part of a frame).
    cache-rendering-hint: true;
    in property <Nowcast> nowcast;
    in property <string> title;
    in property <Theme> theme;
    border-radius: 28px;
    background: root.theme.surface-container;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            WeatherIcon {
                width: 28px; height: 28px;
                kind: root.nowcast.wet ? "rain" : "cloudy";
                ink: root.theme.on-surface-variant;
                cloud-fill: root.theme.surface-container;
            }
            VerticalLayout {
                alignment: center;
                Text { text: root.title; color: root.theme.on-surface-variant; font-size: 12px; font-weight: 500; }
                Text { text: root.nowcast.summary; color: root.theme.on-surface; font-size: 15px; font-weight: 600; wrap: word-wrap; }
            }
        }
        if root.nowcast.wet: HorizontalLayout {
            spacing: 6px;
            height: 64px;
            for bar in root.nowcast.bars: Rectangle {
                Rectangle {
                    y: 44px - self.height;
                    height: bar.wet ? max(4px, bar.height * 44px) : 3px;
                    border-radius: 5px;
                    background: bar.wet ? @linear-gradient(180deg, #8fd0ff 0%, #3d8fe0 100%) : root.theme.outline-variant;
                }
                Text {
                    y: 48px;
                    width: parent.width * 2;
                    text: bar.label;
                    color: root.theme.on-surface-variant; font-size: 11px;
                }
            }
        }
    }
}

/// A row of choices, one selected (Material 3 segmented button).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <Theme> theme;
    callback chosen(int);
    height: 44px;
    border-radius: 22px;
    border-width: 1px;
    border-color: root.theme.outline-variant;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            border-radius: 19px;
            background: i == root.selected ? root.theme.primary : (option-touch.pressed ? root.theme.surface-container-high : transparent);
            Text {
                text: option;
                color: i == root.selected ? root.theme.on-primary : root.theme.on-surface;
                font-size: 13px; font-weight: i == root.selected ? 600 : 400;
                horizontal-alignment: center;
                overflow: elide;
            }
            // Reaches past the outline so the target is 48px tall.
            option-touch := TouchArea { y: -5px; height: parent.height + 10px; clicked => { root.chosen(i); } }
        }
    }
}

/// A labelled on/off switch.
component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in property <bool> on;
    in property <Theme> theme;
    callback toggled(bool);
    min-height: 60px;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Text { text: root.title; color: root.theme.on-surface; font-size: 16px; }
            Text { text: root.help; color: root.theme.on-surface-variant; font-size: 12px; wrap: word-wrap; }
        }
        // The switch: a track with a sliding thumb.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 52px; height: 32px;
                border-radius: 16px;
                background: root.on ? root.theme.primary : root.theme.surface-container-high;
                border-width: root.on ? 0px : 2px;
                border-color: root.theme.on-surface-variant;
                Rectangle {
                    x: root.on ? parent.width - self.width - 4px : 6px;
                    animate x { duration: 150ms; easing: ease-out; }
                    width: root.on ? 24px : 18px; height: self.width; border-radius: self.width / 2;
                    background: root.on ? root.theme.on-primary : root.theme.on-surface-variant;
                }
            }
        }
    }
    TouchArea { clicked => { root.toggled(!root.on); } }
}

/// The settings screen.
component SettingsScreen inherits Rectangle {
    in property <Theme> theme;
    in property <Labels> labels;
    in property <int> units-index;
    in property <int> colors-index;
    in property <int> language-index;
    in property <bool> morning-summary;
    in property <bool> rain-alerts;
    in property <bool> warning-alerts;
    in property <bool> can-use-wallpaper;
    in property <string> source-name;
    callback close();
    callback open-sources();
    callback set-units(int);
    callback set-colors(int);
    callback set-language(int);
    callback set-morning-summary(bool);
    callback set-rain-alerts(bool);
    callback set-warning-alerts(bool);
    background: root.theme.surface;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        padding-top: 44px;
        spacing: 8px;
        HorizontalLayout {
            padding-left: 8px;
            Text { text: root.labels.settings; color: root.theme.on-surface; font-size: 26px; font-weight: 600; vertical-alignment: center; }
            Rectangle {
                width: 72px; height: 48px;
                Text { text: root.labels.done; color: root.theme.primary; font-size: 16px; font-weight: 600; }
                TouchArea { clicked => { root.close(); } }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: settings-list.preferred-height;
            settings-list := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 10px;
                padding: 8px;
                Text { text: root.labels.units; color: root.theme.primary; font-size: 14px; font-weight: 600; }
                Segmented {
                    theme: root.theme;
                    options: [root.labels.metric, root.labels.imperial];
                    selected: root.units-index;
                    chosen(i) => { root.set-units(i); }
                }
                if root.can-use-wallpaper: Text { text: root.labels.colors; color: root.theme.primary; font-size: 14px; font-weight: 600; }
                if root.can-use-wallpaper: Segmented {
                    theme: root.theme;
                    options: [root.labels.colors-weather, root.labels.colors-wallpaper];
                    selected: root.colors-index;
                    chosen(i) => { root.set-colors(i); }
                }
                Text { text: root.labels.language; color: root.theme.primary; font-size: 14px; font-weight: 600; }
                Segmented {
                    theme: root.theme;
                    options: [root.labels.language-system, "English", "Français"];
                    selected: root.language-index;
                    chosen(i) => { root.set-language(i); }
                }
                Text { text: root.labels.notifications; color: root.theme.primary; font-size: 14px; font-weight: 600; }
                SwitchRow {
                    theme: root.theme;
                    title: root.labels.morning-summary; help: root.labels.morning-summary-help;
                    on: root.morning-summary;
                    toggled(on) => { root.set-morning-summary(on); }
                }
                SwitchRow {
                    theme: root.theme;
                    title: root.labels.rain-alerts; help: root.labels.rain-alerts-help;
                    on: root.rain-alerts;
                    toggled(on) => { root.set-rain-alerts(on); }
                }
                SwitchRow {
                    theme: root.theme;
                    title: root.labels.warning-alerts; help: root.labels.warning-alerts-help;
                    on: root.warning-alerts;
                    toggled(on) => { root.set-warning-alerts(on); }
                }
                Text { text: root.labels.data-source; color: root.theme.primary; font-size: 14px; font-weight: 600; }
                Rectangle {
                    height: 56px;
                    border-radius: 20px;
                    background: src-touch.pressed ? root.theme.surface-container-high : root.theme.surface-container;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        Text { text: root.source-name + " · Open-Meteo"; color: root.theme.on-surface; font-size: 15px; vertical-alignment: center; }
                        Text { text: "›"; color: root.theme.primary; font-size: 22px; vertical-alignment: center; horizontal-alignment: right; }
                    }
                    src-touch := TouchArea { clicked => { root.open-sources(); } }
                }
            }
        }
    }
}

// ── Pickers ─────────────────────────────────────────────────────────────

/// One city (or data source) in a picker list.
component CityRow inherits Rectangle {
    in property <CityItem> city;
    in property <bool> removable;
    in property <Theme> theme;
    callback clicked();
    callback remove();
    min-height: 64px;
    border-radius: 20px;
    background: root.city.selected ? root.theme.secondary-container
        : (touch.pressed ? root.theme.surface-container-high : transparent);
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: (root.city.device ? "📍 " : "") + root.city.name;
                color: root.city.selected ? root.theme.on-secondary-container : root.theme.on-surface;
                font-size: 17px; font-weight: root.city.selected ? 600 : 400; overflow: elide;
            }
            if root.city.detail != "": Text {
                text: root.city.detail;
                color: root.city.selected ? root.theme.on-secondary-container.transparentize(25%) : root.theme.on-surface-variant;
                font-size: 13px; wrap: word-wrap;
            }
        }
        if root.city.selected: Text { text: "✓"; color: root.theme.primary; font-size: 18px; font-weight: 600; vertical-alignment: center; }
        if root.removable: Rectangle {
            width: 48px;
            // Drawn rather than a "✕" glyph, which Android's font lacks.
            Path {
                width: 12px; height: 12px;
                viewbox-width: 12; viewbox-height: 12;
                fit: fill;
                commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                stroke: remove-touch.pressed ? root.theme.on-surface : root.theme.on-surface-variant;
                stroke-width: 2px;
            }
            remove-touch := TouchArea { clicked => { root.remove(); } }
        }
    }
}

/// Full-screen list of saved cities with a search bar to add new ones.
component CityPicker inherits Rectangle {
    in property <[CityItem]> cities;
    in property <[CityItem]> results;
    in property <string> search-status;
    in property <bool> can-locate;
    in property <Theme> theme;
    in property <Labels> labels;
    callback close();
    callback locate();
    callback search(string);
    callback add-city(int);
    callback select-city(int);
    callback remove-city(int);

    background: root.theme.surface;
    // Swallow taps so they don't reach the screen underneath.
    TouchArea { }

    VerticalLayout {
        padding: 16px;
        padding-top: 44px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 8px;
            // Material 3 search bar.
            Rectangle {
                height: 56px;
                border-radius: 28px;
                background: root.theme.surface-container-high;
                border-width: input.has-focus ? 2px : 0px;
                border-color: root.theme.primary;
                // Back while typing closes the picker too (keys go to the
                // focused field first, then up to here).
                FocusScope {
                    key-pressed(e) => {
                        if (e.text == Key.Back || e.text == Key.Escape) {
                            root.close();
                            return accept;
                        }
                        return reject;
                    }
                input := TextInput {
                    x: 22px;
                    width: parent.width - 44px;
                    vertical-alignment: center;
                    color: root.theme.on-surface;
                    font-size: 17px;
                    single-line: true;
                    selection-background-color: root.theme.primary-container;
                    edited => { root.search(self.text); }
                }
                }
                if input.text == "": Text {
                    x: 22px;
                    text: root.labels.search;
                    color: root.theme.on-surface-variant;
                    font-size: 17px;
                }
            }
            Rectangle {
                width: 72px;
                Text { text: root.labels.done; color: root.theme.primary; font-size: 16px; font-weight: 600; }
                TouchArea { clicked => { root.close(); } }
            }
        }

        if root.search-status != "": Text {
            text: root.search-status;
            color: root.theme.on-surface-variant;
            font-size: 14px;
            wrap: word-wrap;
        }

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 4px;
                if input.text == "" && root.can-locate: Rectangle {
                    height: 56px;
                    border-radius: 28px;
                    background: locate-touch.pressed ? root.theme.primary-container.darker(8%) : root.theme.primary-container;
                    Text { text: "📍  " + root.labels.use-location; color: root.theme.on-primary-container; font-size: 16px; font-weight: 500; }
                    locate-touch := TouchArea { clicked => { root.locate(); } }
                }
                if input.text == "" && root.can-locate: Rectangle { height: 12px; }
                if input.text == "": Text {
                    text: root.labels.saved-cities; color: root.theme.primary; font-size: 14px; font-weight: 600;
                }
                if input.text == "": VerticalLayout {
                    spacing: 4px;
                    for c[i] in root.cities: CityRow {
                        city: c;
                        theme: root.theme;
                        removable: root.cities.length > 1;
                        clicked => { root.select-city(i); }
                        remove => { root.remove-city(i); }
                    }
                }
                if input.text != "": VerticalLayout {
                    spacing: 4px;
                    for c[i] in root.results: CityRow {
                        city: c;
                        theme: root.theme;
                        clicked => { root.add-city(i); }
                    }
                }
            }
        }
    }
}

/// Full-screen list of weather models to choose from.
component SourcePicker inherits Rectangle {
    in property <[CityItem]> sources;
    in property <Theme> theme;
    in property <Labels> labels;
    callback close();
    callback select(int);
    background: root.theme.surface;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        padding-top: 44px;
        spacing: 12px;
        HorizontalLayout {
            padding-left: 8px;
            Text { text: root.labels.data-source; color: root.theme.on-surface; font-size: 24px; font-weight: 500; vertical-alignment: center; }
            Rectangle {
                width: 72px;
                height: 48px;
                Text { text: root.labels.done; color: root.theme.primary; font-size: 16px; font-weight: 600; }
                TouchArea { clicked => { root.close(); } }
            }
        }
        Text {
            text: root.labels.data-source-help;
            color: root.theme.on-surface-variant;
            font-size: 14px;
            wrap: word-wrap;
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 4px;
                for s[i] in root.sources: CityRow {
                    city: s;
                    theme: root.theme;
                    clicked => { root.select(i); }
                }
            }
        }
    }
}

// ── The main window ─────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "Météo";
    default-font-family: "Lexend";
    // Back (Android's gesture or button; Escape on the desktop) closes what's
    // open, one layer at a time; with nothing open it leaves the app.
    forward-focus: back-keys;
    back-keys := FocusScope {
        key-pressed(e) => {
            if (e.text != Key.Back && e.text != Key.Escape) {
                return reject;
            }
            if (root.source-open) {
                root.source-open = false;
            } else if (root.picker-open) {
                root.picker-open = false;
            } else if (root.settings-open) {
                root.settings-open = false;
            } else {
                return reject;
            }
            return accept;
        }
    }
    // The city search field takes the focus; give it back when it closes.
    changed picker-open => {
        if (!self.picker-open) {
            back-keys.focus();
        }
    }
    preferred-width: 400px;
    preferred-height: 820px;

    in property <string> city: "—";
    in property <string> temperature: "--°";
    in property <string> condition: "Loading…";
    in property <Details> details;
    // "Updated 5 min ago", in the footer.
    in property <string> updated;
    in property <[DayItem]> days;
    in property <string> error;
    // "Offline · updated 2 h ago" when a refresh failed; empty otherwise.
    in property <string> status;
    in property <[CityItem]> cities;
    in property <[CityItem]> results;
    in property <string> search-status;
    in-out property <bool> picker-open;
    /// How many cities are saved, and which is shown (the dots under the city).
    in property <int> city-count;
    in property <int> city-index;
    /// Swiped to the next (1) or previous (-1) saved city.
    callback swipe-city(int);
    // Which day's hour-by-hour chart is open (-1: none); Today by default.
    in-out property <int> open-day: 0;
    /// The open day's hours are being swiped (see DayChart.panning).
    property <bool> chart-panning;
    // A day closed mid-swipe mustn't leave the page unable to scroll.
    changed open-day => { self.chart-panning = false; }
    in property <string> source-name: "Best match";
    in property <[CityItem]> sources;
    in-out property <bool> source-open;
    in property <bool> can-locate;
    in property <Nowcast> nowcast;
    in property <[WarningItem]> warnings;
    in property <AirInfo> air;
    // "3° warmer than usual"; empty if unknown.
    in property <string> vs-normal;
    // Settings (see app/src/lib.rs).
    in-out property <bool> settings-open;
    in property <int> units-index;
    in property <int> colors-index;
    in property <int> language-index;
    in property <bool> morning-summary;
    in property <bool> rain-alerts;
    in property <bool> warning-alerts;
    in property <bool> can-use-wallpaper;
    // Pull to refresh: true while a refresh started that way is running.
    in-out property <bool> refreshing;
    in property <Labels> labels: {
        forecast: "7-day forecast", feels-like: "Feels like", humidity: "Humidity",
        wind: "Wind", sun: "Sun", uv-index: "UV index",
        pressure: "Pressure", refresh: "Refresh", data-source: "Data source", data-source-help: "",
        search: "Search for a city", done: "Done", use-location: "Use my location", saved-cities: "Saved cities",
    };
    in property <Theme> theme: {
        primary: #3c5fa8, on-primary: #ffffff,
        primary-container: #d9e2ff, on-primary-container: #001944,
        secondary-container: #dce2f9, on-secondary-container: #141b2c,
        tertiary-container: #fbd7fc, on-tertiary-container: #29132d,
        surface: #faf9ff, surface-container: #ededf4, surface-container-high: #e3e4ec,
        on-surface: #1a1b21, on-surface-variant: #44464f, outline-variant: #c5c6d0,
        bg-top: #f8e9d2, bg-bottom: #f2d3a6, particle: #3d7bd9, cloud: #ffffff,
    };

    // The theme as shown: each colour fades to the new one (another city,
    // or the weather or time of day changing) instead of snapping.
    property <color> t-primary: root.theme.primary;
    property <color> t-on-primary: root.theme.on-primary;
    property <color> t-primary-container: root.theme.primary-container;
    property <color> t-on-primary-container: root.theme.on-primary-container;
    property <color> t-secondary-container: root.theme.secondary-container;
    property <color> t-on-secondary-container: root.theme.on-secondary-container;
    property <color> t-tertiary-container: root.theme.tertiary-container;
    property <color> t-on-tertiary-container: root.theme.on-tertiary-container;
    property <color> t-surface: root.theme.surface;
    property <color> t-surface-container: root.theme.surface-container;
    property <color> t-surface-container-high: root.theme.surface-container-high;
    property <color> t-on-surface: root.theme.on-surface;
    property <color> t-on-surface-variant: root.theme.on-surface-variant;
    property <color> t-outline-variant: root.theme.outline-variant;
    property <color> t-bg-top: root.theme.bg-top;
    property <color> t-bg-bottom: root.theme.bg-bottom;
    property <color> t-particle: root.theme.particle;
    property <color> t-cloud: root.theme.cloud;
    animate t-primary, t-on-primary, t-primary-container, t-on-primary-container, t-secondary-container, t-on-secondary-container, t-tertiary-container, t-on-tertiary-container, t-surface, t-surface-container, t-surface-container-high, t-on-surface, t-on-surface-variant, t-outline-variant, t-bg-top, t-bg-bottom, t-particle, t-cloud { duration: 800ms; easing: ease-in-out; }
    property <Theme> shown-theme: {
        primary: root.t-primary,
        on-primary: root.t-on-primary,
        primary-container: root.t-primary-container,
        on-primary-container: root.t-on-primary-container,
        secondary-container: root.t-secondary-container,
        on-secondary-container: root.t-on-secondary-container,
        tertiary-container: root.t-tertiary-container,
        on-tertiary-container: root.t-on-tertiary-container,
        surface: root.t-surface,
        surface-container: root.t-surface-container,
        surface-container-high: root.t-surface-container-high,
        on-surface: root.t-on-surface,
        on-surface-variant: root.t-on-surface-variant,
        outline-variant: root.t-outline-variant,
        bg-top: root.t-bg-top,
        bg-bottom: root.t-bg-bottom,
        particle: root.t-particle,
        cloud: root.t-cloud,
    };

    // The quiet landscape (core/src/landscape.rs), coloured by the palette.
    in property <[LandLayer]> land-layers;
    in property <color> ground: #d0c8b8;
    in property <string> icon-kind: "clear-day";
    // "Feels like 9° · Day 15° · Night 10°".
    in property <string> subline;

    // Animated weather (see animation.rs).
    in property <string> rain-far;
    in property <string> rain-near;
    in property <string> splashes;
    in property <string> snow-small;
    in property <string> snow-large;
    in property <string> stars-dim;
    in property <string> stars-mid;
    in property <string> stars-bright;
    in property <string> bolt;
    in property <float> flash;
    in property <[CloudItem]> clouds;
    in property <[FogItem]> fog;

    callback refresh();
    callback open-url(string);
    callback locate();
    callback search(string);
    callback add-city(int);
    callback select-city(int);
    callback remove-city(int);
    callback select-source(int);
    callback set-units(int);
    callback set-colors(int);
    callback set-language(int);
    callback set-morning-summary(bool);
    callback set-rain-alerts(bool);
    callback set-warning-alerts(bool);

    // Where the landscape meets the content cards.
    property <length> horizon: root.height * 0.56;
    property <length> land-height: root.width * 0.75;

    // The theme's colours fade on a change (see shown-theme).
    background: @linear-gradient(180deg, root.shown-theme.bg-top 0%, root.shown-theme.bg-bottom 100%);

    // ── Behind: stars (at night), clouds ──
    Particles { d: root.stars-dim; stroke: #ffffff4d; stroke-width: 2px; }
    Particles { d: root.stars-mid; stroke: #ffffff99; stroke-width: 2.5px; }
    Particles { d: root.stars-bright; stroke: #ffffffee; stroke-width: 3px; }
    for c in root.clouds: Cloud { cloud: c; tint: root.shown-theme.cloud; }

    // ── The land, tone on tone ──
    Landscape {
        layers: root.land-layers;
        ground: root.ground;
        horizon: root.horizon;
    }

    // ── In front: mist, rain, snow, lightning ──
    for f in root.fog: Rectangle {
        x: f.x * 1px; y: f.y * 1px;
        width: f.width * 1px; height: f.height * 1px;
        border-radius: self.height / 2;
        background: root.shown-theme.cloud;
        opacity: f.opacity;
    }
    Particles { d: root.rain-far; stroke: root.shown-theme.particle.transparentize(70%); stroke-width: 1px; }
    Particles { d: root.rain-near; stroke: root.shown-theme.particle.transparentize(40%); stroke-width: 1.6px; }
    Particles { d: root.snow-small; stroke: root.shown-theme.particle.transparentize(25%); stroke-width: 4px; }
    Particles { d: root.snow-large; stroke: root.shown-theme.particle; stroke-width: 7px; }
    Particles { d: root.bolt; stroke: #c8d8ff66; stroke-width: 10px; stroke-line-join: round; }
    Particles { d: root.bolt; stroke: white; stroke-width: 2.5px; stroke-line-join: round; }
    if root.flash > 0.01: Rectangle { background: #e8eeff; opacity: root.flash * 0.45; }

    // ── Content: scrolls over the scene ──
    // Tops of the cards, in window coordinates, for drops to land on.
    out property <[length]> surface-tops: [
        forecast-card.absolute-position.y,
        details-card.absolute-position.y,
        footer-card.absolute-position.y,
    ];
    in property <float> compass-heading;

    // Pull to refresh with plain scrolling: the content starts with a strip
    // (`pull-zone`) scrolled just out of view. Pulling down from the top
    // reveals it; once it's fully shown and has stopped moving, the timer
    // refreshes and scrolls it away again. (Slint's Flickable has no
    // overscroll, and a gesture handler around it delays its touches.)
    property <length> pull-zone: 72px;
    property <length> pull: max(0px, content-flick.content-y + root.pull-zone);
    property <length> last-pull;
    pull-timer := Timer {
        interval: 200ms;
        running: root.pull > 1px;
        triggered => {
            // Still moving: wait. Settled: refresh if fully pulled, then hide the strip.
            if (abs(root.pull - root.last-pull) > 1px) {
                root.last-pull = root.pull;
            } else {
                if (root.pull > root.pull-zone - 16px && !root.refreshing) {
                    root.refreshing = true;
                    root.refresh();
                }
                content-flick.content-y = -root.pull-zone;
                root.last-pull = 0px;
            }
        }
    }
    // Explicit size, so the content's height (which depends on the window's)
    // doesn't feed back into the window's own size constraints.
    content-flick := Flickable {
        x: 0; y: 0;
        interactive: !root.chart-panning;
        width: root.width;
        height: root.height;
        content-width: self.width;
        content-height: content.preferred-height;
        // Start with the pull strip hidden above the top.
        init => { self.content-y = -root.pull-zone; }
        content := VerticalLayout {
            width: parent.width;
            spacing: 0px;

            // The pull strip: an arrow that turns to the accent once pulled far enough.
            Rectangle {
                height: root.pull-zone;
                Path {
                    y: parent.height - 36px;
                    width: 24px; height: 24px;
                    viewbox-width: 24; viewbox-height: 24;
                    fit: fill;
                    commands: "M 19 12 A 7 7 0 1 1 16.5 6.6 M 16.5 2.5 L 16.5 6.6 L 12.4 6.6";
                    stroke: root.pull > root.pull-zone - 16px ? root.shown-theme.primary : root.shown-theme.on-surface-variant;
                    stroke-width: 2.4px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }

            // Hero: city, icon, big temperature, condition — centred. Swipe it
            // left or right for the next or previous saved city.
            Rectangle {
                height: root.horizon - 40px;
                swipe := SwipeGestureHandler {
                    handle-swipe-left: root.city-count > 1;
                    handle-swipe-right: root.city-count > 1;
                    property <length> dx: self.swiping ? self.current-position.x - self.pressed-position.x : 0;
                    swiped => {
                        if (self.current-position.x - self.pressed-position.x < -60px) {
                            root.swipe-city(1);
                        } else if (self.current-position.x - self.pressed-position.x > 60px) {
                            root.swipe-city(-1);
                        }
                    }
                VerticalLayout {
                    // Follows the finger, a little damped, and fades.
                    x: swipe.dx * 0.6;
                    animate x { duration: 220ms; easing: ease-out; }
                    opacity: 1 - min(0.6, abs(swipe.dx) / 400px);
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 40px;
                    spacing: 2px;
                    alignment: start;
                    // City pill: tap to switch or add cities.
                    HorizontalLayout {
                        alignment: center;
                        // Balances the settings button on the right.
                        Rectangle { width: 44px; }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            height: 36px;
                            width: city-row.preferred-width;
                            border-radius: 18px;
                            background: city-touch.pressed ? root.shown-theme.surface-container-high : root.shown-theme.surface-container.transparentize(35%);
                            city-row := HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 14px;
                                spacing: 8px;
                                Text { text: root.city; color: root.shown-theme.on-surface; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                                // Chevron drawn as a path ("▾" is missing from Android's font).
                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 12px; height: 7px;
                                        viewbox-width: 14; viewbox-height: 8;
                                        fit: fill;
                                        commands: "M 1 1 L 7 7 L 13 1";
                                        stroke: root.shown-theme.on-surface-variant;
                                        stroke-width: 2px;
                                    }
                                }
                            }
                            // 48px tall to tap; the pill is drawn at 36px.
                            city-touch := TouchArea { y: -6px; height: parent.height + 12px; clicked => { root.picker-open = true; } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Settings: a "tune" icon (two sliders).
                        Rectangle {
                            width: 48px; height: 36px;
                            border-radius: 18px;
                            background: gear-touch.pressed ? root.shown-theme.surface-container-high : transparent;
                            Path {
                                width: 20px; height: 20px;
                                viewbox-width: 20; viewbox-height: 20;
                                fit: fill;
                                commands: "M 3 6 L 17 6 M 3 14 L 17 14 M 7 3.5 L 7 8.5 M 13 11.5 L 13 16.5";
                                stroke: root.shown-theme.on-surface;
                                stroke-width: 2px;
                                stroke-line-cap: round;
                            }
                            gear-touch := TouchArea { y: -6px; height: parent.height + 12px; clicked => { root.settings-open = true; } }
                        }
                    }
                    // Which of the saved cities this is.
                    if root.city-count > 1: HorizontalLayout {
                        alignment: center;
                        padding-top: 8px;
                        spacing: 6px;
                        for i in root.city-count: Rectangle {
                            width: 6px; height: 6px; border-radius: 3px;
                            background: i == root.city-index ? root.shown-theme.on-surface : root.shown-theme.on-surface.transparentize(70%);
                        }
                    }
                    if root.status != "": HorizontalLayout {
                        alignment: center;
                        padding-top: 6px;
                        Rectangle {
                            height: 26px;
                            width: status-text.preferred-width + 20px;
                            border-radius: 13px;
                            background: root.shown-theme.surface-container-high;
                            status-text := Text { text: root.status; color: root.shown-theme.on-surface-variant; font-size: 12px; }
                        }
                    }
                    Rectangle { height: 14px; }
                    HorizontalLayout {
                        alignment: center;
                        WeatherIcon {
                            width: 76px; height: 76px;
                            kind: root.icon-kind;
                            ink: root.shown-theme.on-surface-variant;
                            cloud-fill: root.shown-theme.bg-top;
                        }
                    }
                    Text {
                        text: root.temperature;
                        color: root.shown-theme.on-surface; font-size: 104px; font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.condition;
                        color: root.shown-theme.on-surface; font-size: 20px; font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.subline;
                        color: root.shown-theme.on-surface-variant; font-size: 14px;
                        horizontal-alignment: center;
                    }
                    if root.vs-normal != "": HorizontalLayout {
                        alignment: center;
                        padding-top: 8px;
                        Rectangle {
                            height: 26px;
                            width: normal-text.preferred-width + 20px;
                            border-radius: 13px;
                            background: root.shown-theme.surface-container.transparentize(35%);
                            normal-text := Text { text: root.vs-normal; color: root.shown-theme.on-surface; font-size: 12px; font-weight: 500; }
                        }
                    }
                    if root.error != "": Text {
                        text: root.error; color: root.shown-theme.on-surface; font-size: 13px; wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
                }
            }

            // Cards, floating on the gradient.
            Rectangle {
                min-height: root.height - root.horizon + 40px;
                VerticalLayout {
                    padding: 14px;
                    padding-top: 0px;
                    // Room above Android's gesture bar.
                    padding-bottom: 40px;
                    spacing: 12px;
                    alignment: start;
                    // Official warnings first: the most important thing to see.
                    if root.warnings.length > 0: WarningsCard {
                        warnings: root.warnings;
                        source: root.labels.warnings-source;
                        open => { root.open-url("https://meteoalarm.org"); }
                    }
                    if root.nowcast.summary != "": NowcastCard {
                        nowcast: root.nowcast;
                        title: root.labels.next-hours;
                        theme: root.shown-theme;
                    }

                    // 7-day forecast; a day opens hour by hour.
                    forecast-card := Rectangle {
                        background: root.shown-theme.surface-container;
                        border-radius: 28px;
                        VerticalLayout {
                            padding: 10px;
                            padding-top: 18px;
                            spacing: 2px;
                            Text {
                                x: 10px;
                                text: root.labels.forecast;
                                color: root.shown-theme.on-surface; font-size: 18px; font-weight: 600;
                            }
                            Rectangle { height: 6px; }
                            for d[i] in root.days: VerticalLayout {
                                DayRow {
                                    day: d;
                                    theme: root.shown-theme;
                                    open: root.open-day == i;
                                    clicked => { root.open-day = root.open-day == i ? -1 : i; }
                                }
                                if root.open-day == i: DayChart {
                                    day: d; theme: root.shown-theme;
                                    changed panning => { root.chart-panning = self.panning; }
                                }
                            }
                        }
                    }

                    // Details: one list.
                    details-card := Rectangle {
                        // Drawn once into an image and reused while other parts move.
                        cache-rendering-hint: true;
                        border-radius: 28px;
                        background: root.shown-theme.surface-container;
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 18px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            DetailRow {
                                theme: root.shown-theme; label: root.labels.wind;
                                note: root.details.wind-gusts == "" ? root.details.wind-from : root.details.wind-from + " · " + root.details.wind-gusts;
                                value: root.details.wind-speed + " " + root.details.wind-unit;
                                arrow: root.details.wind-arrow-path == "" ? "M 0 0" : root.details.wind-arrow-path;
                                heading: root.compass-heading;
                            }
                            DetailRow { theme: root.shown-theme; icon: RowIcons.thermometer; label: root.labels.feels-like; note: root.details.feels-note; value: root.details.feels-like; }
                            DetailRow { theme: root.shown-theme; icon: RowIcons.droplet; label: root.labels.humidity; note: root.details.dew-point; value: root.details.humidity; }
                            DetailRow { theme: root.shown-theme; icon: RowIcons.uv; label: root.labels.uv-index; note: root.details.uv-level; value: root.details.uv; }
                            DetailRow { theme: root.shown-theme; icon: RowIcons.pressure; label: root.labels.pressure; note: root.details.pressure-note; value: root.details.pressure; }
                            DetailRow { theme: root.shown-theme; icon: RowIcons.leaf; label: root.labels.air-quality; note: root.air.aqi-level; value: root.air.aqi; }
                            DetailRow { theme: root.shown-theme; icon: RowIcons.flower; label: root.labels.pollen; note: root.air.pollen-outlook == "" ? root.air.pollen-level : root.air.pollen-level + "\n" + root.air.pollen-outlook; value: root.air.pollen; }
                            DetailRow {
                                theme: root.shown-theme; icon: RowIcons.sun; label: root.labels.sun;
                                note: root.details.daylight;
                                value: root.details.sunrise + " – " + root.details.sunset;
                                last: true;
                            }
                        }
                    }

                    // Footer: where the data comes from, and when it was updated.
                    footer-card := Rectangle {
                        // Drawn once into an image and reused while other parts move.
                        cache-rendering-hint: true;
                        border-radius: 22px;
                        background: root.shown-theme.surface-container;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 0px;
                            // Data source: opens the list of models.
                            Rectangle {
                                height: 48px;
                                border-radius: 18px;
                                background: source-touch.pressed ? root.shown-theme.surface-container-high : transparent;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: root.labels.data-source; color: root.shown-theme.on-surface-variant; font-size: 11px; }
                                        Text { text: root.source-name + " · Open-Meteo"; color: root.shown-theme.on-surface; font-size: 14px; font-weight: 500; }
                                    }
                                    Text { text: "›"; color: root.shown-theme.primary; font-size: 20px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; }
                                }
                                source-touch := TouchArea { clicked => { root.source-open = true; } }
                            }
                            Rectangle { height: 1px; background: root.shown-theme.outline-variant; }
                            // When it was updated, and refresh.
                            HorizontalLayout {
                                padding: 4px;
                                padding-left: 12px;
                                spacing: 8px;
                                Text {
                                    text: root.updated;
                                    color: root.shown-theme.on-surface-variant; font-size: 12px;
                                    vertical-alignment: center; overflow: elide;
                                }
                                TonalButton {
                                    width: 104px; height: 36px; font-size: 14px;
                                    text: root.labels.refresh; theme: root.shown-theme;
                                    clicked => { root.refresh(); }
                                }
                            }
                            // The credit Open-Meteo's licence asks for, linking to them.
                            Rectangle {
                                height: 30px;
                                Text {
                                    text: root.labels.data-credit;
                                    color: credit-touch.pressed ? root.shown-theme.on-surface : root.shown-theme.on-surface-variant;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                                credit-touch := TouchArea {
                                    y: -9px; height: parent.height + 18px;
                                    clicked => { root.open-url("https://open-meteo.com/"); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }


    // Splashes land on the cards, so they're drawn in front of them.
    Particles { d: root.splashes; stroke: root.shown-theme.particle.transparentize(20%); stroke-width: 2.5px; }

    // While a pull-started refresh runs: a pill with the arrow.
    if root.refreshing: Rectangle {
        x: (root.width - self.width) / 2;
        y: 92px;
        width: 44px; height: 44px;
        border-radius: 22px;
        background: root.shown-theme.surface-container;
        drop-shadow-color: #0000002a;
        drop-shadow-blur: 8px;
        Path {
            width: 22px; height: 22px;
            viewbox-width: 24; viewbox-height: 24;
            fit: fill;
            // A circular arrow.
            commands: "M 19 12 A 7 7 0 1 1 16.5 6.6 M 16.5 2.5 L 16.5 6.6 L 12.4 6.6";
            stroke: root.shown-theme.primary;
            stroke-width: 2.4px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
    }

    if root.settings-open: SettingsScreen {
        width: root.width;
        height: root.height;
        theme: root.shown-theme;
        labels: root.labels;
        units-index: root.units-index;
        colors-index: root.colors-index;
        language-index: root.language-index;
        morning-summary: root.morning-summary;
        rain-alerts: root.rain-alerts;
        warning-alerts: root.warning-alerts;
        can-use-wallpaper: root.can-use-wallpaper;
        source-name: root.source-name;
        close => { root.settings-open = false; }
        open-sources => { root.source-open = true; }
        set-units(i) => { root.set-units(i); }
        set-colors(i) => { root.set-colors(i); }
        set-language(i) => { root.set-language(i); }
        set-morning-summary(on) => { root.set-morning-summary(on); }
        set-rain-alerts(on) => { root.set-rain-alerts(on); }
        set-warning-alerts(on) => { root.set-warning-alerts(on); }
    }

    if root.picker-open: CityPicker {
        width: root.width;
        height: root.height;
        cities: root.cities;
        results: root.results;
        search-status: root.search-status;
        can-locate: root.can-locate;
        theme: root.shown-theme;
        labels: root.labels;
        locate => { root.locate(); }
        close => { root.picker-open = false; root.search(""); }
        search(text) => { root.search(text); }
        add-city(i) => { root.add-city(i); self.close(); }
        select-city(i) => { root.select-city(i); self.close(); }
        remove-city(i) => { root.remove-city(i); }
    }

    if root.source-open: SourcePicker {
        width: root.width;
        height: root.height;
        sources: root.sources;
        theme: root.shown-theme;
        labels: root.labels;
        close => { root.source-open = false; }
        select(i) => { root.select-source(i); root.source-open = false; }
    }
}
